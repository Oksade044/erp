# Caddy reverse proxy — mobil/desktop tətbiq üçün avtomatik HTTPS.
# {$DOMAIN} docker-compose-dəki DOMAIN dəyişənindən gəlir (məs. 186.240.145.239.sslip.io).
# Caddy Let's Encrypt sertifikatını avtomatik alır və yeniləyir.

{$DOMAIN} {
	encode gzip

	# Auto-update faylları (version.json + ERP-Setup.exe) — statik verilir.
	# /srv/updates konteynerə mount olunur (deploy/updates → :ro).
	handle_path /updates/* {
		root * /srv/updates
		file_server browse
	}

	# Qalan hər şey API-yə (reverse proxy).
	handle {
		reverse_proxy api:8080
	}
}
