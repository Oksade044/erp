{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=erp.db"
  },
  "Jwt": {
    "Issuer": "ERP",
    "Audience": "ERP.Clients",
    "Key": "bu-lokal-inkisaf-uchun-gizli-acardir-en-azi-32-bayt-olmalidir!!",
    "AccessTokenMinutes": 43200
  },
  "RateLimiting": {
    "GlobalPermitLimit": 600,
    "GlobalWindowSeconds": 10,
    "AuthPermitLimit": 60,
    "AuthWindowSeconds": 60
  },
  "Storage": {
    "Root": "storage"
  },
  "Cache": {
    "Provider": "Memory",
    "RedisConnection": "localhost:6379",
    "DefaultTtlSeconds": 30
  }
}
