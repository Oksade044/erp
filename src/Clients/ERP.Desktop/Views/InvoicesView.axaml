<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="620"
             x:Class="ERP.Desktop.Views.InvoicesView"
             x:DataType="vm:InvoicesViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">

        <TextBlock Grid.Row="0" Text="Fakturalar &amp; Ödənişlər" FontSize="24"
                   FontWeight="SemiBold" Margin="0,0,0,16" />

        <Border Grid.Row="1" Background="#F5F6FA" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Width="240" PlaceholderText="Faktura №, sifariş və ya müştəri" Text="{Binding Search}" />
                    <Button Content="Axtar" Command="{Binding LoadCommand}" />
                    <Button Content="📄 PDF aç" Command="{Binding OpenPdfCommand}"
                            Background="#1971C2" Foreground="White" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Ödəniş:" VerticalAlignment="Center" />
                    <TextBox Width="120" PlaceholderText="Məbləğ" Text="{Binding PayAmount}" />
                    <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PayMethod}" Width="120" />
                    <Button Content="+ Ödəniş əlavə et" Command="{Binding AddPaymentCommand}"
                            Background="#2F9E44" Foreground="White" />
                    <TextBlock Text="(seçilmiş fakturaya)" VerticalAlignment="Center" Foreground="#8A90A6" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Invoices}" SelectedItem="{Binding Selected}"
                  IsReadOnly="True" GridLinesVisibility="Horizontal"
                  BorderThickness="1" BorderBrush="#E0E2EA">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Faktura №" Binding="{Binding InvoiceNumber}" Width="Auto" />
                <DataGridTextColumn Header="Sifariş" Binding="{Binding OrderNumber}" Width="Auto" />
                <DataGridTextColumn Header="Müştəri" Binding="{Binding CustomerName}" Width="2*" />
                <DataGridTextColumn Header="Tarix" Binding="{Binding IssueDate}" Width="Auto" />
                <DataGridTextColumn Header="Məbləğ" Binding="{Binding TotalAmount}" Width="Auto" />
                <DataGridTextColumn Header="Ödənilib" Binding="{Binding AmountPaid}" Width="Auto" />
                <DataGridTextColumn Header="Qalıq" Binding="{Binding Balance}" Width="Auto" />
                <DataGridTextColumn Header="Valyuta" Binding="{Binding Currency}" Width="Auto" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#5A6072" Margin="0,10,0,0" />
    </Grid>
</UserControl>
