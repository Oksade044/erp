<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="620"
             x:Class="ERP.Desktop.Views.InvoicesView"
             x:DataType="vm:InvoicesViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="Fakturalar &amp; Ödənişlər" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="ⓘ" FontSize="14" Width="28" Height="28" Padding="0" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" Foreground="#3B5BDB"
                    ToolTip.Tip="Faktura və ödənişlər haqqında">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel MaxWidth="420" Spacing="6">
                            <TextBlock Text="Fakturalar və ödənişlər" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Text="Faktura sifariş üçün 'Sifarişlər' bölməsində yaradılır. Burada fakturaya ödənişlər əlavə olunur və PDF qəbz açılır." />
                            <TextBlock TextWrapping="Wrap" Foreground="#5A6072" Text="• 📄 PDF aç: seçilmiş fakturanın çap/qəbz PDF-ini açır (məhsul şəkilləri ilə).&#10;• Ödəniş əlavə et: seçilmiş fakturaya məbləğ+üsul yazır. Status avtomatik dəyişir: Ödənilməmiş → Qismən → Ödənilmiş. Artıq ödəniş qəbul edilmir." />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <Border Grid.Row="1" Background="#F5F6FA" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Width="280" PlaceholderText="Faktura №, sifariş və ya müştəri (yazdıqca süzülür)" Text="{Binding Search}"
                             ToolTip.Tip="Yazdıqca süzülür, Enter də işləyir">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding LoadCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Content="🔍 Axtar" Command="{Binding LoadCommand}" ToolTip.Tip="Axtarışı işə salır (Enter ilə eynidir)" />
                    <Button Content="📄 PDF aç" Command="{Binding OpenPdfCommand}"
                            Background="#1971C2" Foreground="White"
                            ToolTip.Tip="Seçilmiş fakturanın PDF qəbzini açır (məhsul şəkilləri, sətirlər, ödəniş tarixçəsi)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Ödəniş (seçilmiş fakturaya):" VerticalAlignment="Center" />
                    <TextBox Width="120" PlaceholderText="Məbləğ (AZN)" Text="{Binding PayAmount}"
                             ToolTip.Tip="Müştərinin ödədiyi məbləğ. Qalıq borcdan çox ola bilməz." />
                    <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PayMethod}" Width="120"
                              ToolTip.Tip="Ödəniş üsulu: Nağd / Köçürmə / Kart" />
                    <Button Content="+ Ödəniş əlavə et" Command="{Binding AddPaymentCommand}"
                            Background="#2F9E44" Foreground="White"
                            ToolTip.Tip="Seçilmiş fakturaya ödəniş yazır və qalıq borcu azaldır" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Invoices}" SelectedItem="{Binding Selected}"
                  IsReadOnly="True" GridLinesVisibility="Horizontal"
                  BorderThickness="1" BorderBrush="#E0E2EA">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Faktura №" Binding="{Binding InvoiceNumber}" Width="Auto" />
                <DataGridTextColumn Header="Sifariş" Binding="{Binding OrderNumber}" Width="Auto" />
                <DataGridTextColumn Header="Müştəri" Binding="{Binding CustomerName}" Width="2*" />
                <DataGridTextColumn Header="Tarix" Binding="{Binding IssueDate}" Width="Auto" />
                <DataGridTextColumn Header="Məbləğ" Binding="{Binding TotalAmount}" Width="Auto" />
                <DataGridTextColumn Header="Ödənilib" Binding="{Binding AmountPaid}" Width="Auto" />
                <DataGridTextColumn Header="Qalıq" Binding="{Binding Balance}" Width="Auto" />
                <DataGridTextColumn Header="Valyuta" Binding="{Binding Currency}" Width="Auto" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#5A6072" Margin="0,10,0,0" />
    </Grid>
</UserControl>
