<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="620"
             x:Class="ERP.Desktop.Views.CustomerDebtsView"
             x:DataType="vm:CustomerDebtsViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
            <TextBlock Text="Borclar — bizə borclu müştərilər" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="⟳ Yenilə" Command="{Binding LoadCommand}" VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="1" Background="#FFF0F0" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <TextBlock FontWeight="SemiBold" Foreground="#C92A2A">
                <Run Text="Ümumi bizə qalıq borc:" />
                <Run Text="{Binding TotalDebt, StringFormat={}{0:0.00}}" />
                <Run Text="AZN" />
            </TextBlock>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Debts}" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E0E2EA">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Müştəri" Binding="{Binding CustomerName}" Width="2*" />
                <DataGridTextColumn Header="Faktura / sifariş" Binding="{Binding InvoiceNumber}" Width="*" />
                <DataGridTextColumn Header="Ümumi məbləğ" Binding="{Binding Total, StringFormat={}{0:0.00}}" Width="*" />
                <DataGridTextColumn Header="Ödənilib" Binding="{Binding Paid, StringFormat={}{0:0.00}}" Width="*" />
                <DataGridTextColumn Header="Qalıq borc" Binding="{Binding Balance, StringFormat={}{0:0.00}}" Width="*" />
                <DataGridTextColumn Header="Val." Binding="{Binding Currency}" Width="Auto" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#5A6072" Margin="0,10,0,0" />
    </Grid>
</UserControl>
