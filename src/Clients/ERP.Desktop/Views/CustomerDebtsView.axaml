<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="620"
             x:Class="ERP.Desktop.Views.CustomerDebtsView"
             x:DataType="vm:CustomerDebtsViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="24">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
            <TextBlock Text="Borclar — bizə borclu müştərilər" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="⟳ Yenilə" Command="{Binding LoadCommand}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Ödəniş paneli — seçilmiş borcu azalt -->
        <Border Grid.Row="1" Background="#F0F4FF" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Seçilmiş borcu ödə:" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Selected.CustomerName}" VerticalAlignment="Center" Foreground="#1971C2" />
                <TextBlock Text="Məbləğ:" VerticalAlignment="Center" />
                <TextBox Width="120" Text="{Binding PayAmount}" />
                <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PayMethod}" Width="110" />
                <Button Content="💵 Ödə (borcu azalt)" Command="{Binding PayCommand}"
                        Background="#2F9E44" Foreground="White"
                        ToolTip.Tip="Cədvəldən müştəri borcu seçin, məbləği yazın və ödəyin — borc azalır." />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Debts}" SelectedItem="{Binding Selected}" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E0E2EA">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Müştəri" Binding="{Binding CustomerName}" Width="2*" />
                <DataGridTextColumn Header="Mənbə" Binding="{Binding Source}" Width="Auto" />
                <DataGridTextColumn Header="Sifariş / qeyd" Binding="{Binding Reference}" Width="*" />
                <DataGridTextColumn Header="Ümumi" Binding="{Binding Total, StringFormat={}{0:0.00}}" Width="*" />
                <DataGridTextColumn Header="Ödənilib" Binding="{Binding Paid, StringFormat={}{0:0.00}}" Width="*" />
                <DataGridTextColumn Header="Qalıq borc" Binding="{Binding Balance, StringFormat={}{0:0.00}}" Width="*" />
                <DataGridTextColumn Header="Val." Binding="{Binding Currency}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Sağ aşağıda ümumi borc -->
        <Border Grid.Row="3" Background="#FFF0F0" CornerRadius="8" Padding="14,10" Margin="0,12,0,0" HorizontalAlignment="Right">
            <TextBlock FontWeight="Bold" FontSize="16" Foreground="#C92A2A">
                <Run Text="Ümumi bizə qalıq borc:" />
                <Run Text="{Binding TotalDebt, StringFormat={}{0:0.00}}" />
                <Run Text="AZN" />
            </TextBlock>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding Status}" Foreground="#5A6072" Margin="0,8,0,0" />
    </Grid>
</UserControl>
