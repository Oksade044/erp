<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Desktop.ViewModels"
             xmlns:ctrl="using:ERP.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="620"
             x:Class="ERP.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer>
        <StackPanel Margin="24" Spacing="18">

            <!-- Başlıq -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="İdarə Paneli" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                <ctrl:InfoHelp Title="İdarə Paneli"
                               Text="Biznesin ümumi mənzərəsi bölmələr üzrə: günün işləri, ümumi göstəricilər, maliyyə və analitika siyahıları."
                               Note="Açılışda görünən əsas ekrandır; rəqəmlər ⟳ Yenilə ilə təzələnir." />
                <Button Content="⟳ Yenilə" Command="{Binding LoadCommand}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status}" Foreground="#8A90A6" VerticalAlignment="Center" />
            </StackPanel>

            <!-- ══ BÖLMƏ 1 — GÜNÜN İŞLƏRİ ══ -->
            <Border Classes="section">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="accent" Background="#1971C2" />
                        <TextBlock Text="Günün işləri" Classes="sectionTitle" />
                        <TextBlock Text="— bu gün diqqət tələb edən əməliyyatlar" Classes="sectionHint" />
                    </StackPanel>
                    <WrapPanel>
                        <Border Classes="card" Background="#E7F5FF">
                            <StackPanel>
                                <TextBlock Text="🚚 BUGÜN TƏHVİL" Classes="cardLabel" />
                                <TextBlock Text="{Binding Summary.DeliveriesToday}" Classes="cardValue" Foreground="#1971C2" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Background="#EBFBEE">
                            <StackPanel>
                                <TextBlock Text="↩ BUGÜN QAYTARMA" Classes="cardLabel" />
                                <TextBlock Text="{Binding Summary.ReturnsToday}" Classes="cardValue" Foreground="#2F9E44" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Background="#FFF0F0">
                            <StackPanel>
                                <TextBlock Text="⚠ GECİKMİŞ QAYTARMA" Classes="cardLabel" />
                                <TextBlock Text="{Binding Summary.OverdueReturns}" Classes="cardValue" Foreground="#C92A2A" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Background="#F3F0FF">
                            <StackPanel>
                                <TextBlock Text="📦 HAZIRDA KİRAYƏDƏ" Classes="cardLabel" />
                                <TextBlock Text="{Binding Summary.DeliveredOrders}" Classes="cardValue" Foreground="#7048E8" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Background="#E6FCF5">
                            <StackPanel>
                                <TextBlock Text="💵 BUGÜNKÜ GƏLİR" Classes="cardLabel" />
                                <TextBlock Text="{Binding Summary.IncomeToday, StringFormat={}{0:0.00} AZN}" Classes="cardValue" Foreground="#0CA678" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ══ BÖLMƏ 2 — ÜMUMİ GÖSTƏRİCİLƏR ══ -->
            <Border Classes="section">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="accent" Background="#2F9E44" />
                        <TextBlock Text="Ümumi göstəricilər" Classes="sectionTitle" />
                    </StackPanel>
                    <WrapPanel>
                        <Border Classes="card" Background="#E7F5FF">
                            <StackPanel>
                                <TextBlock Text="GƏLİR (ödənilmiş)" Classes="cardLabel" />
                                <TextBlock Text="{Binding Summary.TotalPaid, StringFormat={}{0:0.00} AZN}" Classes="cardValue" Foreground="#1971C2" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Background="#FFF0F6">
                            <StackPanel>
                                <TextBlock Text="QALIQ BORC" Classes="cardLabel" />
                                <TextBlock Text="{Binding Summary.TotalOutstanding, StringFormat={}{0:0.00} AZN}" Classes="cardValue" Foreground="#E03131" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Background="#F3F0FF">
                            <StackPanel>
                                <TextBlock Text="SİFARİŞLƏR" Classes="cardLabel" />
                                <TextBlock Text="{Binding Summary.OrderCount}" Classes="cardValue" Foreground="#7048E8" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Background="#EBFBEE">
                            <StackPanel>
                                <TextBlock Text="MÜŞTƏRİLƏR" Classes="cardLabel" />
                                <TextBlock Text="{Binding Summary.CustomerCount}" Classes="cardValue" Foreground="#2F9E44" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Background="#FFF9DB">
                            <StackPanel>
                                <TextBlock Text="MƏHSULLAR" Classes="cardLabel" />
                                <TextBlock Text="{Binding Summary.ProductCount}" Classes="cardValue" Foreground="#F08C00" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <!-- Sifariş statusları — zolaq diaqram (#22) -->
                    <Border Background="#F5F6FA" CornerRadius="8" Padding="16,12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Sifariş statusları (qrafik)" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding StatusBars}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StatusBar">
                                        <Grid ColumnDefinitions="110,*,40" Margin="0,3">
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" FontSize="13" />
                                            <Border Grid.Column="1" Height="22" CornerRadius="4" HorizontalAlignment="Left"
                                                    Width="{Binding BarWidth}" Background="{Binding Color}" MinWidth="2" />
                                            <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center"
                                                       HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ══ BÖLMƏ 3 — MALİYYƏ ══ -->
            <Border Classes="section">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="accent" Background="#0CA678" />
                        <TextBlock Text="Maliyyə" Classes="sectionTitle" />
                        <TextBlock Text="— gəlir dövrlər üzrə və illik mənfəət/zərər" Classes="sectionHint" />
                    </StackPanel>

                    <!-- Dövr üzrə gəlir -->
                    <WrapPanel>
                        <Border Classes="card" Background="#E6FCF5">
                            <StackPanel>
                                <TextBlock Text="BU HƏFTƏ" Classes="cardLabel" />
                                <TextBlock Text="{Binding Summary.IncomeThisWeek, StringFormat={}{0:0.00} AZN}" Classes="cardValue" Foreground="#0CA678" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Background="#E6FCF5">
                            <StackPanel>
                                <TextBlock Text="BU AY" Classes="cardLabel" />
                                <TextBlock Text="{Binding Summary.IncomeThisMonth, StringFormat={}{0:0.00} AZN}" Classes="cardValue" Foreground="#099268" />
                            </StackPanel>
                        </Border>
                        <Border Classes="card" Background="#E6FCF5">
                            <StackPanel>
                                <TextBlock Text="BU İL" Classes="cardLabel" />
                                <TextBlock Text="{Binding Summary.IncomeThisYear, StringFormat={}{0:0.00} AZN}" Classes="cardValue" Foreground="#087F5B" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- Mənfəət/Zərər + aylıq grid -->
                    <Grid ColumnDefinitions="Auto,16,*">
                        <StackPanel Grid.Column="0" Spacing="10">
                            <TextBlock Text="Mənfəət / Zərər (cari il)" FontWeight="SemiBold" />
                            <Border Classes="card" Background="#EBFBEE" Width="220" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="ÜMUMİ GƏLİR" Classes="cardLabel" />
                                    <TextBlock Text="{Binding ProfitLoss.TotalIncome, StringFormat={}{0:0.00} AZN}" Classes="cardValue" Foreground="#2B8A3E" />
                                </StackPanel>
                            </Border>
                            <Border Classes="card" Background="#FFF0F0" Width="220" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="ÜMUMİ XƏRC" Classes="cardLabel" />
                                    <TextBlock Text="{Binding ProfitLoss.TotalExpense, StringFormat={}{0:0.00} AZN}" Classes="cardValue" Foreground="#C92A2A" />
                                </StackPanel>
                            </Border>
                            <Border Classes="card" Background="#E7F5FF" Width="220" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="XALİS MƏNFƏƏT" Classes="cardLabel" />
                                    <TextBlock Text="{Binding ProfitLoss.NetProfit, StringFormat={}{0:0.00} AZN}" Classes="cardValue" Foreground="#1971C2" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Aylıq gəlir / xərc (qrafik)" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <!-- Şaquli zolaq diaqram: yaşıl=gəlir, qırmızı=xərc (#22) -->
                            <Border Background="#FBFBFD" CornerRadius="8" Padding="10" BorderBrush="#E9EBF1" BorderThickness="1" Margin="0,0,0,10">
                                <ItemsControl ItemsSource="{Binding MonthBars}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MonthBar">
                                            <StackPanel VerticalAlignment="Bottom">
                                                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Bottom" Height="140">
                                                    <Border Width="14" Background="#2F9E44" CornerRadius="3,3,0,0"
                                                            Height="{Binding IncomeHeight}" VerticalAlignment="Bottom"
                                                            ToolTip.Tip="{Binding Income, StringFormat=Gəlir: {0:0.00}}" />
                                                    <Border Width="14" Background="#E03131" CornerRadius="3,3,0,0"
                                                            Height="{Binding ExpenseHeight}" VerticalAlignment="Bottom"
                                                            ToolTip.Tip="{Binding Expense, StringFormat=Xərc: {0:0.00}}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Month}" FontSize="10" HorizontalAlignment="Center"
                                                           Margin="0,4,0,0" MaxWidth="40" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <DataGrid ItemsSource="{Binding MonthlyRevenue}" IsReadOnly="True" Height="160"
                                      GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E0E2EA">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ay" Binding="{Binding Month}" Width="Auto" />
                                    <DataGridTextColumn Header="Gəlir" Binding="{Binding Income}" Width="*" />
                                    <DataGridTextColumn Header="Xərc" Binding="{Binding Expense}" Width="*" />
                                    <DataGridTextColumn Header="Xalis" Binding="{Binding Net}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ BÖLMƏ 4 — ANALİTİKA ══ -->
            <Border Classes="section">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Classes="accent" Background="#7048E8" />
                        <TextBlock Text="Analitika" Classes="sectionTitle" />
                        <TextBlock Text="— ən aktiv məhsul, müştəri, əməkdaş və borclular" Classes="sectionHint" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,16,*">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ən çox icarəyə verilən (qrafik)" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <Border Background="#FBFBFD" CornerRadius="8" Padding="10" BorderBrush="#E9EBF1" BorderThickness="1" Margin="0,0,0,10">
                                <ItemsControl ItemsSource="{Binding TopProductBars}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StatusBar">
                                            <Grid ColumnDefinitions="130,*,34" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" FontSize="11"
                                                           MaxWidth="125" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" />
                                                <Border Grid.Column="1" Height="18" CornerRadius="4" HorizontalAlignment="Left"
                                                        Width="{Binding BarWidth}" Background="{Binding Color}" MinWidth="2" />
                                                <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center"
                                                           HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <DataGrid ItemsSource="{Binding TopProducts}" IsReadOnly="True" Height="180"
                                      GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E0E2EA">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Məhsul" Binding="{Binding ProductName}" Width="2*" />
                                    <DataGridTextColumn Header="Ədəd" Binding="{Binding TotalQuantityRented}" Width="*" />
                                    <DataGridTextColumn Header="Sifariş" Binding="{Binding OrderCount}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Borclu fakturalar" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding Outstanding}" IsReadOnly="True" Height="220"
                                      GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E0E2EA">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Faktura" Binding="{Binding InvoiceNumber}" Width="Auto" />
                                    <DataGridTextColumn Header="Müştəri" Binding="{Binding CustomerName}" Width="2*" />
                                    <DataGridTextColumn Header="Borc" Binding="{Binding Balance}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,16,*">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Top əməkdaşlar (cari ay dövriyyəsi)" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding TopEmployees}" IsReadOnly="True" Height="200"
                                      GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E0E2EA">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Əməkdaş" Binding="{Binding EmployeeName}" Width="2*" />
                                    <DataGridTextColumn Header="Sifariş" Binding="{Binding OrderCount}" Width="*" />
                                    <DataGridTextColumn Header="Dövriyyə (AZN)" Binding="{Binding TotalRevenue}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ən aktiv müştərilər" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding TopCustomers}" IsReadOnly="True" Height="200"
                                      GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E0E2EA">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Müştəri" Binding="{Binding CustomerName}" Width="2*" />
                                    <DataGridTextColumn Header="Sifariş" Binding="{Binding OrderCount}" Width="*" />
                                    <DataGridTextColumn Header="Fakturalanıb" Binding="{Binding TotalInvoiced}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

    <UserControl.Styles>
        <Style Selector="Border.section">
            <Setter Property="Background" Value="#FBFBFD" />
            <Setter Property="BorderBrush" Value="#E9EBF1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style Selector="Border.accent">
            <Setter Property="Width" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.sectionHint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#8A90A6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Width" Value="190" />
        </Style>
        <Style Selector="TextBlock.cardLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#5A6072" />
        </Style>
        <Style Selector="TextBlock.cardValue">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </UserControl.Styles>
</UserControl>
