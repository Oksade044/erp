<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Desktop.ViewModels"
             xmlns:conv="using:ERP.Desktop.Converters"
             xmlns:local="using:ERP.Desktop"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="980" d:DesignHeight="720"
             x:Class="ERP.Desktop.Views.ProductsView"
             x:DataType="vm:ProductsViewModel">

    <UserControl.Resources>
        <conv:TrackingModeConverter x:Key="TrackingMode" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="24">

        <!-- Başlıq + info -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="Məhsullar (icarə avadanlığı)" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="ⓘ" FontSize="14" Width="28" Height="28" Padding="0" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" Foreground="#3B5BDB"
                    ToolTip.Tip="Bu ekran haqqında ətraflı">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel MaxWidth="380" Spacing="6">
                            <TextBlock Text="Məhsullar modulu" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Text="İcarəyə verilən avadanlıqların kataloqu. Hər məhsulun avtomatik unikal kodu (SKU, məs. PRD-000001), icarə qiyməti, anbar sayı və izləmə növü var." />
                            <TextBlock TextWrapping="Wrap" Foreground="#5A6072"
                                       Text="• Say ilə idarə olunur: eyni əşyadan çox sayda (məs. 200 stul).&#10;• Fərdi izlənilir: hər nüsxə ayrıca (seriya/QR ilə, məs. bahalı avadanlıq)." />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <!-- Axtarış + əməliyyatlar -->
        <Border Grid.Row="1" Background="#F5F6FA" CornerRadius="8" Padding="16" Margin="0,0,0,12" IsVisible="{Binding ListMode}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Width="280" PlaceholderText="Ad, SKU və ya kateqoriya üzrə axtar (yazdıqca süzülür)"
                         Text="{Binding Search}"
                         ToolTip.Tip="Yazdıqca nəticələr avtomatik süzülür. Enter da işləyir.">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding LoadCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Content="🔍 Axtar" Command="{Binding LoadCommand}"
                        ToolTip.Tip="Axtarışı yenidən işə salır (Enter ilə eynidir)" />
                <Button Content="✏ Redaktə et" Command="{Binding BeginEditCommand}"
                        Background="#3B5BDB" Foreground="White"
                        ToolTip.Tip="Seçilmiş məhsulun məlumatlarını dəyişmək üçün açır" />
                <Button Content="🗑 Sil" Command="{Binding DeleteSelectedCommand}"
                        Background="#E03131" Foreground="White"
                        ToolTip.Tip="Seçilmiş məhsulu sil (bərpa oluna bilər)" />
                <Button Content="📊 Excel ixrac" Command="{Binding ExportExcelCommand}"
                        Background="#2F9E44" Foreground="White"
                        ToolTip.Tip="Bütün məhsulları Excel (.xlsx) faylı kimi yükləyir" />
                <Button Content="🏷 QR kod" Command="{Binding ShowQrCommand}"
                        Background="#7048E8" Foreground="White"
                        ToolTip.Tip="Seçilmiş məhsulun SKU-su üçün QR kod yaradıb açır (anbar skanı üçün)" />
                <Button x:Name="UploadImageButton" Content="🖼 Şəkil yüklə"
                        Background="#F08C00" Foreground="White" Click="OnUploadImageClick"
                        ToolTip.Tip="Seçilmiş məhsula şəkil əlavə edir (bütün istifadəçilər görür)" />
            </StackPanel>
        </Border>

        <!-- Əlavə / Redaktə formaları -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E0E2EA" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel Spacing="10">

                <!-- YENİ MƏHSUL (yalnız 'Məhsul yarat' bölməsində) -->
                <StackPanel Spacing="10" IsVisible="{Binding CreateMode}">
                    <TextBlock Text="Yeni məhsul əlavə et" FontWeight="SemiBold" />
                    <TextBlock Text="SKU (məhsul kodu) avtomatik təyin olunur — məs. PRD-000001. Əl ilə yazmaq lazım deyil."
                               Foreground="#8A90A6" FontSize="12" />
                    <WrapPanel>
                        <StackPanel Width="220" Margin="0,0,12,10">
                            <TextBlock Text="Məhsulun adı *" FontSize="12" Foreground="#5A6072" />
                            <TextBox PlaceholderText="Məs: Qızıl rəngli stul" Text="{Binding NewName}" />
                        </StackPanel>
                        <StackPanel Width="150" Margin="0,0,12,10">
                            <TextBlock Text="İcarə qiyməti (AZN) *" FontSize="12" Foreground="#5A6072" />
                            <TextBox PlaceholderText="Məs: 5.00" Text="{Binding NewRentalPrice}"
                                     ToolTip.Tip="Bir icarə üçün baza qiyməti. Sifarişdə dəyişdirilə bilər." />
                        </StackPanel>
                        <StackPanel Width="110" Margin="0,0,12,10">
                            <TextBlock Text="Valyuta" FontSize="12" Foreground="#5A6072" />
                            <ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding NewCurrency}" HorizontalAlignment="Stretch"
                                      ToolTip.Tip="Məhsul qiymətləri hansı valyutadadır (AZN/USD/EUR)." />
                        </StackPanel>
                        <StackPanel Width="150" Margin="0,0,12,10" IsVisible="{Binding CanViewCost}">
                            <TextBlock Text="Alış qiyməti" FontSize="12" Foreground="#5A6072" />
                            <TextBox PlaceholderText="Məs: 40.00" Text="{Binding NewPurchasePrice}"
                                     ToolTip.Tip="Avadanlığın alış/maya dəyəri. Yalnız Admin/Menecer görür." />
                        </StackPanel>
                        <StackPanel Width="150" Margin="0,0,12,10" IsVisible="{Binding CanViewCost}">
                            <TextBlock Text="Satış qiyməti (AZN)" FontSize="12" Foreground="#5A6072" />
                            <TextBox PlaceholderText="Məs: 60.00" Text="{Binding NewSalePrice}"
                                     ToolTip.Tip="Avadanlıq satılarsa qiyməti. Boş buraxıla bilər." />
                        </StackPanel>
                        <!-- #1 — idarəetmə növü gizlədildi (default Toplu) -->
                        <StackPanel Width="200" Margin="0,0,12,10" IsVisible="False">
                            <ComboBox ItemsSource="{Binding TrackingModes}" SelectedItem="{Binding NewTrackingMode}" />
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,12,10">
                            <TextBlock Text="Kateqoriya (siyahıdan seç)" FontSize="12" Foreground="#5A6072" />
                            <ComboBox Width="200" ItemsSource="{Binding CategoryNames}" SelectedItem="{Binding NewCategory}"
                                      PlaceholderText="Kateqoriya seç..."
                                      ToolTip.Tip="Kateqoriyalar 'Mallar → Kateqoriyalar' bölməsində yaradılır (#2b)." />
                        </StackPanel>
                        <StackPanel Width="130" Margin="0,0,12,10">
                            <TextBlock Text="Ölçü vahidi" FontSize="12" Foreground="#5A6072" />
                            <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding NewUnit}" HorizontalAlignment="Stretch"
                                      ToolTip.Tip="Məhsulun ölçü vahidi: Ədəd, Kg, Litr, Dəst və s." />
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,12,10">
                            <TextBlock Text="Şəkil (opsional)" FontSize="12" Foreground="#5A6072" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="📷 Şəkil seç" Click="OnPickNewImageClick"
                                        ToolTip.Tip="Məhsul üçün şəkil seçin — məhsul əlavə olunanda avtomatik yüklənir." />
                                <TextBlock Text="{Binding NewImageName}" Foreground="#2B8A3E" FontSize="12"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                                <TextBlock Text="seçilməyib" Foreground="#8A90A6" FontSize="12" VerticalAlignment="Center"
                                           IsVisible="{Binding NewImageName, Converter={x:Static ObjectConverters.IsNull}}" />
                            </StackPanel>
                        </StackPanel>
                    </WrapPanel>

                    <!-- Anbarlar üzrə ilkin stok — məhsul bir neçə anbarda müxtəlif sayda ola bilər -->
                    <Border Background="#F5F6FA" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Anbarlar üzrə ilkin stok (məhsul bir neçə anbarda ola bilər)" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <StackPanel Width="200">
                                    <TextBlock Text="Anbar" FontSize="12" Foreground="#5A6072" />
                                    <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding AddWarehouse}" HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Width="110">
                                    <TextBlock Text="Say" FontSize="12" Foreground="#5A6072" />
                                    <TextBox PlaceholderText="Məs: 100" Text="{Binding AddQty}" />
                                </StackPanel>
                                <StackPanel Width="100">
                                    <TextBlock Text="Min. həd" FontSize="12" Foreground="#5A6072" />
                                    <TextBox PlaceholderText="0" Text="{Binding AddMin}" />
                                </StackPanel>
                                <Button Content="+ Anbar əlavə et" Command="{Binding AddNewStockRowCommand}"
                                        VerticalAlignment="Bottom" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding NewStocks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NewStockRow">
                                        <Grid ColumnDefinitions="*,100,100,Auto" Margin="0,2">
                                            <TextBlock Grid.Column="0" Text="{Binding WarehouseName}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Quantity, StringFormat=Say: {0}}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding MinQuantity, StringFormat=Min: {0}}" Foreground="#8A90A6" VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Content="✕" Background="#E03131" Foreground="White"
                                                    Command="{Binding $parent[ItemsControl].((vm:ProductsViewModel)DataContext).RemoveNewStockRowCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Button Content="+ Əlavə et" Command="{Binding AddCommand}"
                            Background="#3B5BDB" Foreground="White" HorizontalAlignment="Left" />
                </StackPanel>

                <!-- REDAKTƏ -->
                <StackPanel Spacing="10" IsVisible="{Binding IsEditing}">
                    <TextBlock Text="Məhsulu redaktə et" FontWeight="SemiBold" />
                    <WrapPanel>
                        <StackPanel Width="220" Margin="0,0,12,10">
                            <TextBlock Text="Məhsulun adı *" FontSize="12" Foreground="#5A6072" />
                            <TextBox Text="{Binding EditName}" />
                        </StackPanel>
                        <StackPanel Width="150" Margin="0,0,12,10">
                            <TextBlock Text="İcarə qiyməti (AZN) *" FontSize="12" Foreground="#5A6072" />
                            <TextBox Text="{Binding EditRentalPrice}" />
                        </StackPanel>
                        <StackPanel Width="150" Margin="0,0,12,10" IsVisible="{Binding CanViewCost}">
                            <TextBlock Text="Alış qiyməti (AZN)" FontSize="12" Foreground="#5A6072" />
                            <TextBox Text="{Binding EditPurchasePrice}" />
                        </StackPanel>
                        <StackPanel Width="150" Margin="0,0,12,10" IsVisible="{Binding CanViewCost}">
                            <TextBlock Text="Satış qiyməti (AZN)" FontSize="12" Foreground="#5A6072" />
                            <TextBox Text="{Binding EditSalePrice}" />
                        </StackPanel>
                        <StackPanel Width="200" Margin="0,0,12,10">
                            <TextBlock Text="İdarəetmə növü" FontSize="12" Foreground="#5A6072" />
                            <ComboBox ItemsSource="{Binding TrackingModes}" SelectedItem="{Binding EditTrackingMode}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Width="180" Margin="0,0,12,10">
                            <TextBlock Text="Ümumi stok (avtomatik)" FontSize="12" Foreground="#5A6072" />
                            <TextBox Text="{Binding Selected.TotalStock}" IsEnabled="False"
                                     ToolTip.Tip="Anbarlardan avtomatik hesablanır — əl ilə dəyişdirilmir. Aşağıda anbar üzrə dəyişin." />
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,12,10">
                            <TextBlock Text="Kateqoriya (seç və ya yeni yaz)" FontSize="12" Foreground="#5A6072" />
                            <AutoCompleteBox ItemsSource="{Binding CategoryNames}" Text="{Binding EditCategory}"
                                             FilterMode="ContainsOrdinal" MinimumPrefixLength="0"
                                             PlaceholderText="Məs: Mebel" />
                        </StackPanel>
                        <StackPanel Width="130" Margin="0,0,12,10">
                            <TextBlock Text="Ölçü vahidi" FontSize="12" Foreground="#5A6072" />
                            <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding EditUnit}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Width="140" Margin="0,0,12,10">
                            <TextBlock Text="Aktivdir?" FontSize="12" Foreground="#5A6072" />
                            <CheckBox Content="Satışda / istifadədə" IsChecked="{Binding EditIsActive}" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- #17: Anbarlar üzrə stok (redaktədə) -->
                    <Border Background="#F5F6FA" CornerRadius="8" Padding="12" Margin="0,4,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Anbarlar üzrə stok" FontWeight="SemiBold" />
                            <TextBlock Text="Məhsul bir neçə anbarda ola bilər. Hər anbardakı sayı ayrıca dəyiş və ya köçür."
                                       Foreground="#8A90A6" FontSize="12" />

                            <!-- Mövcud səviyyələr -->
                            <ItemsControl ItemsSource="{Binding EditStockLevels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProductStockRow">
                                        <Grid ColumnDefinitions="*,120,120,Auto" Margin="0,3">
                                            <TextBlock Grid.Column="0" Text="{Binding WarehouseName}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="Say:" FontSize="11" Foreground="#5A6072" VerticalAlignment="Center" />
                                                <TextBox Width="70" Text="{Binding Quantity}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="Min:" FontSize="11" Foreground="#5A6072" VerticalAlignment="Center" />
                                                <TextBox Width="60" Text="{Binding MinQuantity}" />
                                            </StackPanel>
                                            <Button Grid.Column="3" Content="💾"
                                                    Command="{Binding $parent[ItemsControl].((vm:ProductsViewModel)DataContext).SaveStockRowCommand}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="Bu anbarın stokunu yadda saxla" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Anbara əlavə et -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Anbara əlavə et:" VerticalAlignment="Center" Foreground="#5A6072" />
                                <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding StockWarehouse}" Width="150">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox Width="70" PlaceholderText="Say" Text="{Binding StockQty}" />
                                <TextBox Width="60" PlaceholderText="Min" Text="{Binding StockMin}" />
                                <Button Content="+ Yaz" Command="{Binding AddStockToWarehouseCommand}" />
                            </StackPanel>

                            <!-- Transfer -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Köçür:" VerticalAlignment="Center" Foreground="#5A6072" />
                                <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding TransferFrom}" Width="140">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="→" VerticalAlignment="Center" />
                                <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding TransferTo}" Width="140">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox Width="70" PlaceholderText="Say" Text="{Binding TransferQty}" />
                                <Button Content="🔀 Köçür" Command="{Binding TransferStockCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="💾 Yadda saxla" Command="{Binding SaveEditCommand}"
                                Background="#2F9E44" Foreground="White" />
                        <Button Content="Ləğv et" Command="{Binding CancelEditCommand}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Siyahı + şəkil -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" IsVisible="{Binding ListMode}">
            <DataGrid Grid.Column="0" ItemsSource="{Binding Products}" SelectedItem="{Binding Selected}"
                      IsReadOnly="True" CanUserResizeColumns="True" local:GridColumnPersistence.Key="products"
                      GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E0E2EA"
                      DoubleTapped="OnProductDoubleTapped">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU (kod)" Binding="{Binding Sku}" Width="Auto" />
                    <DataGridTextColumn Header="Ad" Binding="{Binding Name}" Width="260" MinWidth="120" />
                    <DataGridTextColumn Header="Vahid" Binding="{Binding Unit}" Width="Auto" />
                    <DataGridTextColumn Header="Kateqoriya" Binding="{Binding Category}" Width="*" />
                    <DataGridTextColumn Header="İcarə qiyməti" Binding="{Binding RentalPrice}" Width="Auto" />
                    <DataGridTextColumn Header="İdarəetmə növü"
                                        Binding="{Binding TrackingMode, Converter={StaticResource TrackingMode}}" Width="Auto" />
                    <DataGridTextColumn Header="Ümumi stok" Binding="{Binding TotalStock}" Width="Auto" />
                    <DataGridTextColumn Header="Boş" Binding="{Binding FreeStock}" Width="Auto" />
                    <DataGridTextColumn Header="Rezervdə" Binding="{Binding ReservedStock}" Width="Auto" />
                    <DataGridTextColumn Header="Kirayədə" Binding="{Binding RentedStock}" Width="Auto" />
                    <DataGridTextColumn Header="Təmirdə" Binding="{Binding InRepairStock}" Width="Auto" />
                    <DataGridTextColumn Header="Zədəli" Binding="{Binding DamagedStock}" Width="Auto" />
                    <DataGridTextColumn Header="Anbar(lar) üzrə" Binding="{Binding WarehouseSummary}" Width="*" />
                    <DataGridTemplateColumn Header="Stok vəziyyəti" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="⚠ Az qalıb" Foreground="#E03131" FontWeight="SemiBold"
                                           Margin="8,0" VerticalAlignment="Center"
                                           IsVisible="{Binding IsLowStock}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridCheckBoxColumn Header="Şəkil var" Binding="{Binding HasImage}" Width="Auto" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Width="220" Margin="12,0,0,0" Background="#F5F6FA"
                    CornerRadius="8" Padding="10">
                <StackPanel Spacing="8">
                    <TextBlock Text="Seçilmiş məhsulun şəkli" FontWeight="SemiBold" />
                    <Image Source="{Binding SelectedImage}" Height="180" Stretch="Uniform" />
                    <TextBlock Text="Şəkil yoxdur — 🖼 Şəkil yüklə düyməsi ilə əlavə et" Foreground="#8A90A6" FontSize="12"
                               TextWrapping="Wrap"
                               IsVisible="{Binding SelectedImage, Converter={x:Static ObjectConverters.IsNull}}" />
                </StackPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="4" Text="{Binding Status}" Foreground="#5A6072" Margin="0,10,0,0" />
    </Grid>
</UserControl>
