<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="620"
             x:Class="ERP.Desktop.Views.ProductsView"
             x:DataType="vm:ProductsViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">

        <TextBlock Grid.Row="0" Text="Məhsullar (icarə avadanlığı)" FontSize="24"
                   FontWeight="SemiBold" Margin="0,0,0,16" />

        <Border Grid.Row="1" Background="#F5F6FA" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Width="240" PlaceholderText="Ad, SKU və ya kateqoriya üzrə axtar"
                             Text="{Binding Search}" />
                    <Button Content="Axtar" Command="{Binding LoadCommand}" />
                    <Button Content="📊 Excel ixrac" Command="{Binding ExportExcelCommand}"
                            Background="#2F9E44" Foreground="White" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Width="130" PlaceholderText="SKU *" Text="{Binding NewSku}" />
                    <TextBox Width="180" PlaceholderText="Ad *" Text="{Binding NewName}" />
                    <TextBox Width="110" PlaceholderText="Qiymət" Text="{Binding NewRentalPrice}" />
                    <ComboBox ItemsSource="{Binding TrackingModes}" SelectedItem="{Binding NewTrackingMode}" Width="110" />
                    <TextBox Width="90" PlaceholderText="Anbar" Text="{Binding NewStock}" />
                    <TextBox Width="130" PlaceholderText="Kateqoriya" Text="{Binding NewCategory}" />
                    <Button Content="+ Əlavə et" Command="{Binding AddCommand}"
                            Background="#3B5BDB" Foreground="White" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Products}" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E0E2EA">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="Auto" />
                <DataGridTextColumn Header="Ad" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Kateqoriya" Binding="{Binding Category}" Width="*" />
                <DataGridTextColumn Header="Qiymət" Binding="{Binding RentalPrice}" Width="Auto" />
                <DataGridTextColumn Header="Valyuta" Binding="{Binding Currency}" Width="Auto" />
                <DataGridTextColumn Header="İzləmə" Binding="{Binding TrackingMode}" Width="Auto" />
                <DataGridTextColumn Header="Anbar" Binding="{Binding StockQuantity}" Width="Auto" />
                <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsActive}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#5A6072" Margin="0,10,0,0" />
    </Grid>
</UserControl>
