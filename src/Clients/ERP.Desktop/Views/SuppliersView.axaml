<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="620"
             x:Class="ERP.Desktop.Views.SuppliersView"
             x:DataType="vm:SuppliersViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="Təchizatçılar" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="ⓘ" FontSize="14" Width="28" Height="28" Padding="0" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" Foreground="#3B5BDB"
                    ToolTip.Tip="Bu modul nə üçündür?">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel MaxWidth="400" Spacing="6">
                            <TextBlock Text="Təchizatçılar nədir?" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Text="Təchizatçı — şirkətin avadanlıq və material ALDIĞI firma və ya şəxsdir (məs. mebel istehsalçısı, işıq avadanlığı satıcısı, parça təchizatçısı)." />
                            <TextBlock TextWrapping="Wrap" Foreground="#5A6072" Text="Burada təchizatçılar qeyd olunur; 'Alışlar' bölməsində onlardan mal alışı edilir və anbar doldurulur. Müştəri ilə qarışdırmayın — müştəri sizdən icarə götürür, təchizatçı sizə mal satır." />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <!-- Axtarış + yeni təchizatçı forması -->
        <Border Grid.Row="1" Background="#F5F6FA" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Width="280" PlaceholderText="Ad, telefon və ya əlaqədar şəxs üzrə axtar (yazdıqca süzülür)"
                             Text="{Binding Search}"
                             ToolTip.Tip="Yazdıqca nəticələr süzülür, Enter də işləyir">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding LoadCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Content="🔍 Axtar" Command="{Binding LoadCommand}" ToolTip.Tip="Axtarışı işə salır (Enter ilə eynidir)" />
                    <Button Content="📒 Defter / Tarixçə" Click="OnOpenLedger"
                            ToolTip.Tip="Seçilmiş təchizatçının borc/ödəniş və danışıq tarixçəsi (sətrə iki klik də açır)" />
                </StackPanel>
                <TextBlock Text="Yeni təchizatçı əlavə et" FontWeight="SemiBold" Margin="0,4,0,0" />
                <WrapPanel>
                    <StackPanel Width="200" Margin="0,0,12,8">
                        <TextBlock Text="Firma / şəxs adı *" FontSize="12" Foreground="#5A6072" />
                        <TextBox PlaceholderText="Məs: Bakı Mebel MMC" Text="{Binding NewName}" />
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,12,8">
                        <TextBlock Text="Telefon *" FontSize="12" Foreground="#5A6072" />
                        <TextBox PlaceholderText="0501234567" Text="{Binding NewPhone}" />
                    </StackPanel>
                    <StackPanel Width="170" Margin="0,0,12,8">
                        <TextBlock Text="Əlaqədar şəxs" FontSize="12" Foreground="#5A6072" />
                        <TextBox PlaceholderText="Məs: Əli Məmmədov" Text="{Binding NewContactPerson}" />
                    </StackPanel>
                    <StackPanel Width="180" Margin="0,0,12,8">
                        <TextBlock Text="E-poçt" FontSize="12" Foreground="#5A6072" />
                        <TextBox PlaceholderText="ornek@firma.az" Text="{Binding NewEmail}" />
                    </StackPanel>
                    <StackPanel Width="130" Margin="0,0,12,8">
                        <TextBlock Text="Şəhər" FontSize="12" Foreground="#5A6072" />
                        <TextBox PlaceholderText="Bakı / Guangzhou" Text="{Binding NewCity}" />
                    </StackPanel>
                    <StackPanel Width="180" Margin="0,0,12,8">
                        <TextBlock Text="Şirkət adı" FontSize="12" Foreground="#5A6072" />
                        <TextBox PlaceholderText="Məs: Guangzhou Decor Co." Text="{Binding NewCompanyName}" />
                    </StackPanel>
                    <StackPanel Width="130" Margin="0,0,12,8">
                        <TextBlock Text="Ölkə" FontSize="12" Foreground="#5A6072" />
                        <TextBox PlaceholderText="Çin / Azərbaycan" Text="{Binding NewCountry}" />
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,12,8">
                        <TextBlock Text="WhatsApp" FontSize="12" Foreground="#5A6072" />
                        <TextBox PlaceholderText="+86 ..." Text="{Binding NewWhatsApp}" />
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,12,8">
                        <TextBlock Text="WeChat" FontSize="12" Foreground="#5A6072" />
                        <TextBox PlaceholderText="WeChat ID" Text="{Binding NewWeChat}" />
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,12,8">
                        <TextBlock Text="Vəzifə" FontSize="12" Foreground="#5A6072" />
                        <TextBox PlaceholderText="Satış meneceri" Text="{Binding NewPosition}" />
                    </StackPanel>
                </WrapPanel>
                <Button Content="+ Əlavə et" Command="{Binding AddCommand}"
                        Background="#3B5BDB" Foreground="White" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <!-- Siyahı -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding Selected}"
                  IsReadOnly="True" DoubleTapped="OnSupplierDoubleTapped"
                  GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E0E2EA">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ad" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Şirkət" Binding="{Binding CompanyName}" Width="*" />
                <DataGridTextColumn Header="Ölkə" Binding="{Binding Country}" Width="Auto" />
                <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="Auto" />
                <DataGridTextColumn Header="WhatsApp" Binding="{Binding WhatsApp}" Width="Auto" />
                <DataGridTextColumn Header="WeChat" Binding="{Binding WeChat}" Width="Auto" />
                <DataGridTextColumn Header="Vəzifə" Binding="{Binding Position}" Width="Auto" />
                <DataGridTextColumn Header="E-poçt" Binding="{Binding Email}" Width="*" />
                <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsActive}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#5A6072" Margin="0,10,0,0" />
    </Grid>
</UserControl>
