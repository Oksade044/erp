<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="620"
             x:Class="ERP.Desktop.Views.AttendanceView"
             x:DataType="vm:AttendanceViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">

        <TextBlock Grid.Row="0" Text="Davamiyyət" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

        <!-- Axtarış + yeni qeyd forması -->
        <Border Grid.Row="1" Background="#F5F6FA" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Width="240" PlaceholderText="İşçi adı üzrə axtar" Text="{Binding Search}" />
                    <Button Content="Axtar" Command="{Binding LoadCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox ItemsSource="{Binding AllEmployees}" SelectedItem="{Binding NewEmployee}" Width="200">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding FullName}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <DatePicker SelectedDate="{Binding NewDate}" />
                    <ComboBox ItemsSource="{Binding AttendanceStatuses}" SelectedItem="{Binding NewStatus}" Width="120" />
                    <TextBox Width="90" PlaceholderText="Gəliş HH:mm" Text="{Binding NewCheckIn}" />
                    <TextBox Width="90" PlaceholderText="Gediş HH:mm" Text="{Binding NewCheckOut}" />
                    <TextBox Width="140" PlaceholderText="Qeyd" Text="{Binding NewNotes}" />
                    <Button Content="+ Əlavə et" Command="{Binding AddCommand}"
                            Background="#3B5BDB" Foreground="White" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Siyahı -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Records}" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E0E2EA">
            <DataGrid.Columns>
                <DataGridTextColumn Header="İşçi" Binding="{Binding EmployeeName}" Width="2*" />
                <DataGridTextColumn Header="Tarix" Binding="{Binding Date}" Width="Auto" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                <DataGridTextColumn Header="Gəliş" Binding="{Binding CheckIn}" Width="Auto" />
                <DataGridTextColumn Header="Gediş" Binding="{Binding CheckOut}" Width="Auto" />
                <DataGridTextColumn Header="Saat" Binding="{Binding WorkedHours}" Width="Auto" />
                <DataGridTextColumn Header="Qeyd" Binding="{Binding Notes}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#5A6072" Margin="0,10,0,0" />
    </Grid>
</UserControl>
