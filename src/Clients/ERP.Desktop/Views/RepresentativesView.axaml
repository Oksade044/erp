<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Desktop.ViewModels"
             xmlns:ctrl="using:ERP.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="ERP.Desktop.Views.RepresentativesView"
             x:DataType="vm:RepresentativesViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Margin="24">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,14">
            <TextBlock Text="Təmsilçi borcları" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ctrl:InfoHelp Title="Təmsilçi borcları (#16-18)"
                           Text="Admin təmsilçiyə razılaşdırılmış məbləği borc kimi yazır (mənfi balans). Təmsilçi sifariş yaratdıqca məbləğ kredit kimi əlavə olunur və borc bağlanır. Mənfi = təmsilçi sifariş yaratmalıdır; müsbət = artıq qazanc."
                           Note="Sifariş yaradılanda avtomatik kredit, ləğv olunanda geri alınır." />
            <Button Content="⟳ Yenilə" Command="{Binding LoadCommand}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Status}" Foreground="#8A90A6" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Borc təyin etmə -->
        <Border Grid.Row="1" Background="#F5F6FA" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Təmsilçiyə borc təyin et:" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBox Width="180" PlaceholderText="Təmsilçi adı (tam ad)" Text="{Binding NewRepName}" />
                <TextBox Width="110" PlaceholderText="Məbləğ" Text="{Binding NewDebtAmount}" />
                <DatePicker SelectedDate="{Binding NewDebtDate}" />
                <TextBox Width="200" PlaceholderText="Qeyd (razılaşma)" Text="{Binding NewDebtNote}" />
                <Button Content="Borc yaz (−)" Command="{Binding AssignDebtCommand}"
                        Background="#C92A2A" Foreground="White" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,16,2*">
            <!-- Balanslar -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Cari balanslar" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding Balances}" SelectedItem="{Binding Selected}" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E0E2EA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Təmsilçi" Binding="{Binding RepresentativeName}" Width="*" />
                        <DataGridTextColumn Header="Balans (AZN)" Binding="{Binding Balance, StringFormat='{}{0:0.00}'}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>

            <!-- Seçilən təmsilçinin defteri -->
            <StackPanel Grid.Column="2">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                    <TextBlock Text="Defter (tarixçə)" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="{Binding LedgerBalance, StringFormat='Cari balans: {0:0.00} AZN'}" FontWeight="Bold" Foreground="#1971C2" VerticalAlignment="Center" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Entries}" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E0E2EA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarix" Binding="{Binding Date}" Width="Auto" />
                        <DataGridTextColumn Header="Növ" Binding="{Binding Type}" Width="Auto" />
                        <DataGridTextColumn Header="Təsir (AZN)" Binding="{Binding SignedAmount, StringFormat='{}{0:+0.00;-0.00}'}" Width="Auto" />
                        <DataGridTextColumn Header="Açıqlama" Binding="{Binding Description}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
