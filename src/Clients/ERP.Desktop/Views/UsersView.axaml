<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Desktop.ViewModels"
             xmlns:ctrl="using:ERP.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="620"
             x:Class="ERP.Desktop.Views.UsersView"
             x:DataType="vm:UsersViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="İstifadəçilər" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ctrl:InfoHelp Title="İstifadəçilər (sistemə giriş)"
                           Text="Proqrama daxil olan işçilərin hesabları və rolları: Admin, Menecer, Anbardar, Kassir. Rol icazələri müəyyən edir — kim hansı bölməni görür/dəyişir."
                           Note="Yalnız Admin/Menecer istifadəçi yarada bilər. Həssas sahələr (məs. alış qiyməti) yalnız Admin/Menecerə görünür." />
        </StackPanel>

        <Border Grid.Row="1" Background="#F5F6FA" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Width="150" PlaceholderText="İstifadəçi adı *" Text="{Binding NewUsername}" />
                <TextBox Width="150" PlaceholderText="Parol *" PasswordChar="•" Text="{Binding NewPassword}" />
                <TextBox Width="180" PlaceholderText="Tam ad *" Text="{Binding NewFullName}" />
                <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding NewRole}" Width="120" />
                <Button Content="+ Yarat" Command="{Binding AddCommand}"
                        Background="#3B5BDB" Foreground="White" />
                <Button Content="⟳" Command="{Binding LoadCommand}" />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Users}" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E0E2EA">
            <DataGrid.Columns>
                <DataGridTextColumn Header="İstifadəçi adı" Binding="{Binding Username}" Width="*" />
                <DataGridTextColumn Header="Tam ad" Binding="{Binding FullName}" Width="2*" />
                <DataGridTextColumn Header="Rol" Binding="{Binding Role}" Width="Auto" />
                <DataGridTextColumn Header="Şifrə (admin)" Binding="{Binding VisiblePassword}" Width="Auto" />
                <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsActive}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#5A6072" Margin="0,10,0,0" />
    </Grid>
</UserControl>
