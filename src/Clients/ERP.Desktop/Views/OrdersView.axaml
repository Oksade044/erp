<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Desktop.ViewModels"
             xmlns:conv="using:ERP.Desktop.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="620"
             x:Class="ERP.Desktop.Views.OrdersView"
             x:DataType="vm:OrdersViewModel">

    <UserControl.Resources>
        <conv:StatusColorConverter x:Key="StatusColor" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="24">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="İcarə Sifarişləri" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="ⓘ" FontSize="14" Width="28" Height="28" Padding="0" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" Foreground="#3B5BDB"
                    ToolTip.Tip="Sifariş axını və düymələr haqqında ətraflı">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel MaxWidth="460" Spacing="6">
                            <TextBlock Text="Sifariş həyat dövrü (status axını)" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Text="Qaralama → Təsdiqlənmiş → Təhvil verilmiş → Qaytarılmış. İstənilən vaxt (təhvildən əvvəl) Ləğv edilə bilər." />
                            <TextBlock TextWrapping="Wrap"><Run Text="✓ Təsdiqlə:" FontWeight="SemiBold" /><Run Text=" Qaralama → Təsdiqlənmiş. Avadanlığı bu tarixlərə REZERV edir (ikiqat bron yoxlanılır). Geri: Ləğv et." /></TextBlock>
                            <TextBlock TextWrapping="Wrap"><Run Text="🚚 Təhvil ver:" FontWeight="SemiBold" /><Run Text=" Təsdiqlənmiş → Təhvil verilmiş. Avadanlıq müştəriyə verildi. Geri qaytarıla bilməz (yalnız Qaytar)." /></TextBlock>
                            <TextBlock TextWrapping="Wrap"><Run Text="↩ Qaytar:" FontWeight="SemiBold" /><Run Text=" Təhvil verilmiş → Qaytarılmış. Avadanlıq geri alındı, rezerv boşalır. Sonra depozit hesablaşması edilə bilər." /></TextBlock>
                            <TextBlock TextWrapping="Wrap"><Run Text="✕ Ləğv et:" FontWeight="SemiBold" /><Run Text=" Sifarişi ləğv edir, rezervi boşaldır. Təhvil verilmiş sifariş ləğv EDİLƏ BİLMƏZ." /></TextBlock>
                            <TextBlock TextWrapping="Wrap"><Run Text="💰 Faktura yarat:" FontWeight="SemiBold" /><Run Text=" Bu sifariş üçün faktura açır. Ödəniş və PDF qəbz 'Fakturalar' bölməsindədir." /></TextBlock>
                            <TextBlock TextWrapping="Wrap" Foreground="#5A6072" Text="Depozit: təhvildən əvvəl təyin et. Hesablaşma (zədə/cərimə) yalnız qaytarıldıqdan sonra." />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <TextBox Width="200" PlaceholderText="Sifariş № və ya müştəri (yazdıqca süzülür)" Text="{Binding Search}"
                     ToolTip.Tip="Müştəri adı və ya sifariş nömrəsi üzrə axtar. Yazdıqca süzülür, Enter də işləyir.">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding LoadCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
            <Button Content="🔍 Axtar" Command="{Binding LoadCommand}" ToolTip.Tip="Axtarışı işə salır (Enter ilə eynidir)" />
            <Button Content="➕ Yeni Sifariş" Command="{Binding ToggleNewOrderCommand}"
                    Background="#3B5BDB" Foreground="White"
                    ToolTip.Tip="Yeni icarə sifarişi forması açır (müştəri, tarixlər, məhsul sətirləri)" />
            <Button Content="📋 Detal" Click="OnOrderDetail"
                    ToolTip.Tip="Seçilmiş sifarişin tam detalı: yaradan/təsdiqləyən, ödənişlər, dəyişiklik tarixçəsi (cədvəldə iki dəfə klik də açır)" />
            <Button Content="✓ Təsdiqlə" Command="{Binding ConfirmCommand}"
                    Background="#2F9E44" Foreground="White"
                    ToolTip.Tip="Seçilmiş sifarişi təsdiqləyir: Qaralama → Təsdiqlənmiş. Avadanlığı rezerv edir (ikiqat bron yoxlanılır)." />
            <Button Content="🚚 Təhvil" Command="{Binding DeliverCommand}"
                    Background="#1971C2" Foreground="White"
                    ToolTip.Tip="Avadanlığı müştəriyə təhvil verir: Təsdiqlənmiş → Təhvil verilmiş." />
            <Button Content="↩ Qaytar" Command="{Binding ReturnCommand}"
                    Background="#7048E8" Foreground="White"
                    ToolTip.Tip="Avadanlığı geri qəbul edir: Təhvil verilmiş → Qaytarılmış. Rezerv boşalır." />
            <Button Content="✕ Ləğv" Command="{Binding CancelCommand}"
                    Background="#E03131" Foreground="White"
                    ToolTip.Tip="Sifarişi ləğv edir və rezervi boşaldır. Təhvil verilmiş sifariş ləğv edilə bilməz." />
            <Button Content="💰 Faktura" Command="{Binding CreateInvoiceCommand}"
                    Background="#F08C00" Foreground="White"
                    ToolTip.Tip="Bu sifariş üçün faktura yaradır. Ödəniş və PDF 'Fakturalar' bölməsindədir." />
        </StackPanel>

        <!-- Yeni sifariş forması -->
        <Border Grid.Row="2" Background="#F5F6FA" CornerRadius="8" Padding="16" Margin="0,0,0,16"
                IsVisible="{Binding ShowNewOrder}">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Müştəri:" VerticalAlignment="Center" Width="60" />
                    <ComboBox ItemsSource="{Binding AllCustomers}" SelectedItem="{Binding NewCustomer}" Width="220">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Tarix:" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <DatePicker SelectedDate="{Binding NewStartDate}" />
                    <TextBlock Text="—" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding NewEndDate}" />
                </StackPanel>

                <!-- Məsul əməkdaş seçimi — yalnız Admin/Menecer (sifariş kimin adına) -->
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanChooseCreator}">
                    <TextBlock Text="Kimin adına:" VerticalAlignment="Center" Width="80"
                               ToolTip.Tip="Sifariş hansı məsul əməkdaşın adına yazılsın. Boş buraxsanız — sizin adınıza." />
                    <ComboBox ItemsSource="{Binding AllEmployees}" SelectedItem="{Binding SelectedCreator}" Width="220"
                              PlaceholderText="(mən özüm)">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding FullName}" /><Run Text=" — " Foreground="#8A90A6" /><Run Text="{Binding Position}" Foreground="#8A90A6" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="✕" Command="{Binding ClearCreatorCommand}"
                            ToolTip.Tip="Seçimi təmizlə (öz adıma)" Padding="8,2" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Məhsul:" VerticalAlignment="Center" Width="60" />
                    <ComboBox ItemsSource="{Binding AllProducts}" SelectedItem="{Binding LineProduct}" Width="220">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Width="80" PlaceholderText="Say" Text="{Binding LineQuantity}" />
                    <Button Content="+ Sətir" Command="{Binding AddLineCommand}" />
                </StackPanel>

                <DataGrid ItemsSource="{Binding DraftLines}" IsReadOnly="True" Height="130"
                          GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E0E2EA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Məhsul" Binding="{Binding ProductName}" Width="2*" />
                        <DataGridTextColumn Header="Say" Binding="{Binding Quantity}" Width="*" />
                        <DataGridTextColumn Header="Qiymət" Binding="{Binding UnitPrice}" Width="*" />
                        <DataGridTextColumn Header="Cəm" Binding="{Binding LineTotal}" Width="*" />
                        <DataGridTemplateColumn Header="" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:CompileBindings="False">
                                    <Button Content="✕" Background="#E03131" Foreground="White"
                                            Command="{Binding $parent[DataGrid].DataContext.RemoveLineCommand}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding DraftTotal, StringFormat=Cəmi: {0:0.00} AZN}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="Sifarişi yarat" Command="{Binding CreateOrderCommand}"
                            Background="#2F9E44" Foreground="White" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Depozit & qaytarma hesablaşması (seçilmiş sifariş üçün) -->
        <Border Grid.Row="3" Background="#FFF9DB" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Depozit (AZN):" VerticalAlignment="Center"
                           ToolTip.Tip="Müştəridən alınan girov məbləği. Təhvildən əvvəl təyin edilir." />
                <TextBox Width="100" PlaceholderText="Məs: 200" Text="{Binding DepositAmount}" />
                <Button Content="Depoziti təyin et" Command="{Binding SetDepositCommand}"
                        ToolTip.Tip="Seçilmiş sifarişə depozit məbləğini yazır (qaytarılmadan/ləğv olunmadan əvvəl)" />
                <Rectangle Width="1" Fill="#D0D0D0" Margin="6,0" />
                <TextBlock Text="Zədə (AZN):" VerticalAlignment="Center"
                           ToolTip.Tip="Qaytarılan avadanlıqda zədə üçün tutulan məbləğ" />
                <TextBox Width="90" PlaceholderText="0" Text="{Binding DamageCharge}" />
                <TextBlock Text="Cərimə (AZN):" VerticalAlignment="Center"
                           ToolTip.Tip="Gecikmə və ya digər səbəbdən cərimə məbləği" />
                <TextBox Width="90" PlaceholderText="0" Text="{Binding PenaltyCharge}" />
                <TextBox Width="150" PlaceholderText="Hesablaşma qeydi" Text="{Binding SettlementNotes}" />
                <Button Content="Hesablaş" Command="{Binding SettleCommand}"
                        Background="#7048E8" Foreground="White"
                        ToolTip.Tip="Depozitdən zədə+cərimə çıxılır, qalıq müştəriyə qaytarılır. Yalnız qaytarıldıqdan sonra." />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="4" ItemsSource="{Binding Orders}" SelectedItem="{Binding Selected}"
                  IsReadOnly="True" GridLinesVisibility="Horizontal"
                  BorderThickness="1" BorderBrush="#E0E2EA"
                  DoubleTapped="OnOrderDoubleTapped">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sifariş №" Binding="{Binding OrderNumber}" Width="Auto" />
                <DataGridTextColumn Header="Müştəri" Binding="{Binding CustomerName}" Width="2*" />
                <DataGridTextColumn Header="Başlama" Binding="{Binding StartDate}" Width="Auto" />
                <DataGridTextColumn Header="Bitmə" Binding="{Binding EndDate}" Width="Auto" />
                <DataGridTemplateColumn Header="Status" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Status, Converter={StaticResource StatusColor}}"
                                    CornerRadius="4" Padding="8,3" Margin="6,2" HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Yaradan" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,0" VerticalAlignment="Center"
                                        ToolTip.Tip="Bu sifarişi yaradan istifadəçi (girişdən avtomatik)">
                                <TextBlock Text="{Binding CreatedByName}" />
                                <TextBlock Text="{Binding CreatedByRole}" Foreground="#8A90A6" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Məbləğ" Binding="{Binding Total}" Width="Auto" />
                <DataGridTextColumn Header="Depozit" Binding="{Binding Deposit}" Width="Auto" />
                <DataGridTextColumn Header="Tutulma" Binding="{Binding TotalCharges}" Width="Auto" />
                <DataGridTextColumn Header="Qaytarma" Binding="{Binding DepositRefund}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="5" Text="{Binding Status}" Foreground="#5A6072" Margin="0,10,0,0" />
    </Grid>
</UserControl>
