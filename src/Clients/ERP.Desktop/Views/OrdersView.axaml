<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="620"
             x:Class="ERP.Desktop.Views.OrdersView"
             x:DataType="vm:OrdersViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="24">

        <TextBlock Grid.Row="0" Text="İcarə Sifarişləri" FontSize="24"
                   FontWeight="SemiBold" Margin="0,0,0,16" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <TextBox Width="200" PlaceholderText="Sifariş № və ya müştəri" Text="{Binding Search}" />
            <Button Content="Axtar" Command="{Binding LoadCommand}" />
            <Button Content="➕ Yeni Sifariş" Command="{Binding ToggleNewOrderCommand}"
                    Background="#3B5BDB" Foreground="White" />
            <Button Content="✓ Təsdiqlə" Command="{Binding ConfirmCommand}"
                    Background="#2F9E44" Foreground="White" />
            <Button Content="🚚 Təhvil" Command="{Binding DeliverCommand}"
                    Background="#1971C2" Foreground="White" />
            <Button Content="↩ Qaytar" Command="{Binding ReturnCommand}"
                    Background="#7048E8" Foreground="White" />
            <Button Content="✕ Ləğv" Command="{Binding CancelCommand}"
                    Background="#E03131" Foreground="White" />
            <Button Content="💰 Faktura" Command="{Binding CreateInvoiceCommand}"
                    Background="#F08C00" Foreground="White" />
        </StackPanel>

        <!-- Yeni sifariş forması -->
        <Border Grid.Row="2" Background="#F5F6FA" CornerRadius="8" Padding="16" Margin="0,0,0,16"
                IsVisible="{Binding ShowNewOrder}">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Müştəri:" VerticalAlignment="Center" Width="60" />
                    <ComboBox ItemsSource="{Binding AllCustomers}" SelectedItem="{Binding NewCustomer}" Width="220">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Tarix:" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <DatePicker SelectedDate="{Binding NewStartDate}" />
                    <TextBlock Text="—" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding NewEndDate}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Məhsul:" VerticalAlignment="Center" Width="60" />
                    <ComboBox ItemsSource="{Binding AllProducts}" SelectedItem="{Binding LineProduct}" Width="220">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox Width="80" PlaceholderText="Say" Text="{Binding LineQuantity}" />
                    <Button Content="+ Sətir" Command="{Binding AddLineCommand}" />
                </StackPanel>

                <DataGrid ItemsSource="{Binding DraftLines}" IsReadOnly="True" Height="130"
                          GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E0E2EA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Məhsul" Binding="{Binding ProductName}" Width="2*" />
                        <DataGridTextColumn Header="Say" Binding="{Binding Quantity}" Width="*" />
                        <DataGridTextColumn Header="Qiymət" Binding="{Binding UnitPrice}" Width="*" />
                        <DataGridTextColumn Header="Cəm" Binding="{Binding LineTotal}" Width="*" />
                        <DataGridTemplateColumn Header="" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:CompileBindings="False">
                                    <Button Content="✕" Background="#E03131" Foreground="White"
                                            Command="{Binding $parent[DataGrid].DataContext.RemoveLineCommand}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{Binding DraftTotal, StringFormat=Cəmi: {0:0.00} AZN}"
                               FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="Sifarişi yarat" Command="{Binding CreateOrderCommand}"
                            Background="#2F9E44" Foreground="White" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Depozit & qaytarma hesablaşması (seçilmiş sifariş üçün) -->
        <Border Grid.Row="3" Background="#FFF9DB" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Depozit:" VerticalAlignment="Center" />
                <TextBox Width="100" Text="{Binding DepositAmount}" />
                <Button Content="Təyin et" Command="{Binding SetDepositCommand}" />
                <Rectangle Width="1" Fill="#D0D0D0" Margin="6,0" />
                <TextBlock Text="Hesablaşma — Zədə:" VerticalAlignment="Center" />
                <TextBox Width="90" Text="{Binding DamageCharge}" />
                <TextBlock Text="Cərimə:" VerticalAlignment="Center" />
                <TextBox Width="90" Text="{Binding PenaltyCharge}" />
                <TextBox Width="150" PlaceholderText="Qeyd" Text="{Binding SettlementNotes}" />
                <Button Content="Hesablaş" Command="{Binding SettleCommand}"
                        Background="#7048E8" Foreground="White" />
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="4" ItemsSource="{Binding Orders}" SelectedItem="{Binding Selected}"
                  IsReadOnly="True" GridLinesVisibility="Horizontal"
                  BorderThickness="1" BorderBrush="#E0E2EA">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sifariş №" Binding="{Binding OrderNumber}" Width="Auto" />
                <DataGridTextColumn Header="Müştəri" Binding="{Binding CustomerName}" Width="2*" />
                <DataGridTextColumn Header="Başlama" Binding="{Binding StartDate}" Width="Auto" />
                <DataGridTextColumn Header="Bitmə" Binding="{Binding EndDate}" Width="Auto" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
                <DataGridTextColumn Header="Məbləğ" Binding="{Binding Total}" Width="Auto" />
                <DataGridTextColumn Header="Depozit" Binding="{Binding Deposit}" Width="Auto" />
                <DataGridTextColumn Header="Tutulma" Binding="{Binding TotalCharges}" Width="Auto" />
                <DataGridTextColumn Header="Qaytarma" Binding="{Binding DepositRefund}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="5" Text="{Binding Status}" Foreground="#5A6072" Margin="0,10,0,0" />
    </Grid>
</UserControl>
