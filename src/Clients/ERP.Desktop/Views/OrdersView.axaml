<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Desktop.ViewModels"
             xmlns:conv="using:ERP.Desktop.Converters"
             xmlns:prod="using:ERP.Shared.Contracts.Products"
             xmlns:local="using:ERP.Desktop"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="620"
             x:Class="ERP.Desktop.Views.OrdersView"
             x:DataType="vm:OrdersViewModel">

    <UserControl.Resources>
        <conv:StatusColorConverter x:Key="StatusColor" />
    </UserControl.Resources>

    <Panel>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="24">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="İcarə Sifarişləri" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="ⓘ" FontSize="14" Width="28" Height="28" Padding="0" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" Foreground="#3B5BDB"
                    ToolTip.Tip="Sifariş axını və düymələr haqqında ətraflı">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel MaxWidth="460" Spacing="6">
                            <TextBlock Text="Sifariş həyat dövrü (status axını)" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Text="Qaralama → Təsdiqlənmiş → Təhvil verilmiş → Qaytarılmış. İstənilən vaxt (təhvildən əvvəl) Ləğv edilə bilər." />
                            <TextBlock TextWrapping="Wrap"><Run Text="✓ Təsdiqlə:" FontWeight="SemiBold" /><Run Text=" Qaralama → Təsdiqlənmiş. Avadanlığı bu tarixlərə REZERV edir (ikiqat bron yoxlanılır). Geri: Ləğv et." /></TextBlock>
                            <TextBlock TextWrapping="Wrap"><Run Text="🚚 Təhvil ver:" FontWeight="SemiBold" /><Run Text=" Təsdiqlənmiş → Təhvil verilmiş. Avadanlıq müştəriyə verildi. Geri qaytarıla bilməz (yalnız Qaytar)." /></TextBlock>
                            <TextBlock TextWrapping="Wrap"><Run Text="↩ Qaytar:" FontWeight="SemiBold" /><Run Text=" Təhvil verilmiş → Qaytarılmış. Avadanlıq geri alındı, rezerv boşalır. Sonra depozit hesablaşması edilə bilər." /></TextBlock>
                            <TextBlock TextWrapping="Wrap"><Run Text="✕ Ləğv et:" FontWeight="SemiBold" /><Run Text=" Sifarişi ləğv edir, rezervi boşaldır. Təhvil verilmiş sifariş ləğv EDİLƏ BİLMƏZ." /></TextBlock>
                            <TextBlock TextWrapping="Wrap"><Run Text="💰 Faktura yarat:" FontWeight="SemiBold" /><Run Text=" Bu sifariş üçün faktura açır. Ödəniş və PDF qəbz 'Fakturalar' bölməsindədir." /></TextBlock>
                            <TextBlock TextWrapping="Wrap" Foreground="#5A6072" Text="Depozit: təhvildən əvvəl təyin et. Hesablaşma (zədə/cərimə) yalnız qaytarıldıqdan sonra." />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16" IsVisible="{Binding ListMode}">
            <TextBox Width="200" PlaceholderText="Sifariş № və ya müştəri (yazdıqca süzülür)" Text="{Binding Search}"
                     ToolTip.Tip="Müştəri adı və ya sifariş nömrəsi üzrə axtar. Yazdıqca süzülür, Enter də işləyir.">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding LoadCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
            <Button Content="🔍 Axtar" Command="{Binding LoadCommand}" ToolTip.Tip="Axtarışı işə salır (Enter ilə eynidir)" />
            <TextBlock Text="Növ:" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding SelectedTypeFilter}" Width="110"
                      ToolTip.Tip="Sifariş növünə görə süzgəc: İcarə, Satış və ya hamısı." />
            <Button Content="✓✓ Seçilənləri təsdiqlə" Command="{Binding ConfirmSelectedCommand}"
                    Background="#0CA678" Foreground="White"
                    ToolTip.Tip="Checkbox ilə bir neçə qaralama sifariş seçin və hamısını birdəfəyə təsdiqləyin (#7)." />
        </StackPanel>

        <!-- Yeni sifariş forması (yaratma və ya qaralama düzənləmə) -->
        <Border Grid.Row="2" Background="#F5F6FA" CornerRadius="8" Padding="16" Margin="0,0,0,16"
                IsVisible="{Binding FormVisible}">
            <StackPanel Spacing="10">
                <!-- #33 — sifariş növü -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Növ:" VerticalAlignment="Center" Width="60" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding OrderTypes}" SelectedItem="{Binding NewOrderType}" Width="150"
                              ToolTip.Tip="İcarə — müvəqqəti (tarix/depozit/qaytarma). Satış — birdəfəlik (qaytarma/depozit yox)." />
                    <TextBlock Text="🟢 İcarə" VerticalAlignment="Center" IsVisible="{Binding IsRental}" Foreground="#2B8A3E" />
                    <TextBlock Text="🔵 Satış" VerticalAlignment="Center" IsVisible="{Binding !IsRental}" Foreground="#1971C2" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Müştəri:" VerticalAlignment="Center" Width="60" />
                    <ComboBox ItemsSource="{Binding AllCustomers}" SelectedItem="{Binding NewCustomer}" Width="220">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <!-- İcarə üçün tarixlər (satışda gizli) -->
                    <TextBlock Text="Tarix:" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding IsRental}" />
                    <DatePicker SelectedDate="{Binding NewStartDate}" IsVisible="{Binding IsRental}" />
                    <TextBlock Text="—" VerticalAlignment="Center" IsVisible="{Binding IsRental}" />
                    <DatePicker SelectedDate="{Binding NewEndDate}" IsVisible="{Binding IsRental}" />
                    <!-- #17 — depozit yalnız burada (yaratma/qaralama) -->
                    <TextBlock Text="Depozit:" VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding IsRental}" />
                    <TextBox Width="100" PlaceholderText="0" Text="{Binding NewDeposit}" IsVisible="{Binding IsRental}"
                             ToolTip.Tip="Girov/depozit məbləği — yalnız sifariş yaradılarkən təyin olunur." />
                </StackPanel>

                <!-- Məsul əməkdaş seçimi — yalnız Admin/Menecer (sifariş kimin adına) -->
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanChooseCreator}">
                    <TextBlock Text="Kimin adına:" VerticalAlignment="Center" Width="80"
                               ToolTip.Tip="Sifariş hansı məsul əməkdaşın adına yazılsın. Boş buraxsanız — sizin adınıza." />
                    <ComboBox ItemsSource="{Binding AllEmployees}" SelectedItem="{Binding SelectedCreator}" Width="220"
                              PlaceholderText="(mən özüm)">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding FullName}" /><Run Text=" — " Foreground="#8A90A6" /><Run Text="{Binding Position}" Foreground="#8A90A6" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="✕" Command="{Binding ClearCreatorCommand}"
                            ToolTip.Tip="Seçimi təmizlə (öz adıma)" Padding="8,2" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="📋 Kateqoriyadan məhsul seç" Click="OnOpenPicker"
                            Background="#3B5BDB" Foreground="White" FontSize="14" Padding="14,8"
                            ToolTip.Tip="Kateqoriya-məhsul seçim pəncərəsi: kateqoriya seçin, məhsulları checkbox ilə işarələyin, birdəfəyə əlavə edin (#2/#5)" />
                    <TextBlock VerticalAlignment="Center" Foreground="#5A6072"
                               Text="Məhsullar yalnız kateqoriyadan seçilir; say/qiymət aşağıdakı cədvəldə redaktə olunur." />
                </StackPanel>

                <!-- #28 — seçilmiş məhsulun kartı (şəkil + məlumat + yekun stok) -->
                <Border Background="#F5F6FA" CornerRadius="8" Padding="12"
                        IsVisible="{Binding LineProduct, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Image Source="{Binding SelectedLineImage}" Width="90" Height="90" Stretch="Uniform" />
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LineProduct.Name}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding LineProduct.Sku, StringFormat=SKU: {0}}" Foreground="#5A6072" FontSize="12" />
                            <TextBlock Text="{Binding LineProduct.Category, StringFormat=Kateqoriya: {0}}" Foreground="#5A6072" FontSize="12" />
                            <TextBlock Text="{Binding LineProduct.RentalPrice, StringFormat=Standart kirayə: {0:0.00} AZN}" FontSize="12" />
                            <TextBlock Text="{Binding LineProduct.SalePrice, StringFormat=Satış: {0:0.00} AZN}" FontSize="12"
                                       IsVisible="{Binding LineProduct.SalePrice, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LineProduct.TotalStock, StringFormat=Ümumi stok: {0}}" FontSize="12" />
                            <TextBlock Text="{Binding LineProduct.FreeStock, StringFormat=Boş: {0}}" FontSize="12" Foreground="#2B8A3E" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding LineProduct.ReservedStock, StringFormat=Rezervdə: {0}}" FontSize="12" Foreground="#E8590C" />
                            <TextBlock Text="{Binding LineProduct.RentedStock, StringFormat=Kirayədə: {0}}" FontSize="12" Foreground="#1971C2" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- #18/#19/#28 — seçilmiş məhsulun anbarlar üzrə mövcudluğu -->
                <DataGrid ItemsSource="{Binding LineAvailability}" IsReadOnly="True" Height="90"
                          GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E0E2EA"
                          IsVisible="{Binding LineProduct, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Anbar" Binding="{Binding WarehouseName}" Width="2*" />
                        <DataGridTextColumn Header="Mövcud" Binding="{Binding Total}" Width="*" />
                        <DataGridTextColumn Header="Rezervdə" Binding="{Binding Reserved}" Width="*" />
                        <DataGridTextColumn Header="Kirayədə" Binding="{Binding Rented}" Width="*" />
                        <DataGridTextColumn Header="Boş" Binding="{Binding Free}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <DataGrid ItemsSource="{Binding DraftLines}" IsReadOnly="False" MinHeight="260"
                          GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E0E2EA"
                          ToolTip.Tip="Say və Qiymət xanalarına iki dəfə klik edərək dəyişin (#6)">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Məhsul" Binding="{Binding ProductName}" Width="2*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Anbar" Binding="{Binding WarehouseName}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Say ✎" Binding="{Binding Quantity}" Width="*" />
                        <DataGridTemplateColumn Header="Stok" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:CompileBindings="False">
                                    <TextBlock Text="{Binding StockHint}" VerticalAlignment="Center" Margin="6,0"
                                               Foreground="{Binding ExceedsStock, Converter={x:Static conv:BoolToRedGrayConverter.Instance}}"
                                               FontWeight="{Binding ExceedsStock, Converter={x:Static conv:BoolToBoldConverter.Instance}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Qiymət ✎" Binding="{Binding UnitPrice}" Width="*" />
                        <DataGridTextColumn Header="Cəm" Binding="{Binding LineTotal}" Width="*" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:CompileBindings="False">
                                    <Button Content="✕" Background="#E03131" Foreground="White"
                                            Command="{Binding $parent[DataGrid].DataContext.RemoveLineCommand}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center">
                        <Run Text="Cəmi:" />
                        <Run Text="{Binding DraftTotal, StringFormat={}{0:0.00}}" />
                        <Run Text="{Binding DraftCurrency}" />
                    </TextBlock>
                    <Button Content="{Binding SaveButtonText}" Command="{Binding CreateOrderCommand}"
                            Background="#2F9E44" Foreground="White" />
                    <Button Content="✕ Düzəltmədən çıx" Command="{Binding CancelEditCommand}"
                            IsVisible="{Binding IsEditingOrder}" Background="#E03131" Foreground="White"
                            ToolTip.Tip="Dəyişiklikləri saxlamadan düzənləmədən çıx" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="4" x:Name="OrdersGrid" ItemsSource="{Binding Orders}" SelectedItem="{Binding Selected}"
                  IsReadOnly="True" CanUserResizeColumns="True" local:GridColumnPersistence.Key="orders"
                  SelectionMode="Extended"
                  GridLinesVisibility="Horizontal" IsVisible="{Binding ListMode}"
                  BorderThickness="1" BorderBrush="#E0E2EA"
                  DoubleTapped="OnOrderDoubleTapped">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="☑" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:OrderRow">
                            <CheckBox IsChecked="{Binding IsSelected}" Margin="8,0"
                                      IsVisible="{Binding IsDraft}"
                                      ToolTip.Tip="Toplu təsdiq üçün qaralama sifarişi seç" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- #17 — statusa görə kontekstual əməliyyat düymələri -->
                <DataGridTemplateColumn Header="Əməliyyat" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:CompileBindings="False">
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="6,3" VerticalAlignment="Center">
                                <Button Content="✎ Düzənlə" IsVisible="{Binding CanEdit}" FontSize="10" Padding="6,2"
                                        Command="{Binding $parent[DataGrid].DataContext.EditDraftCommand}" CommandParameter="{Binding}" />
                                <Button Content="🚚 Təhvil ver" IsVisible="{Binding CanDeliver}" FontSize="10" Padding="6,2"
                                        Background="#2F9E44" Foreground="White"
                                        Command="{Binding $parent[DataGrid].DataContext.DeliverRowCommand}" CommandParameter="{Binding}" />
                                <Button Content="↩ Qaytarıldı" IsVisible="{Binding CanReturn}" FontSize="10" Padding="6,2"
                                        Background="#1971C2" Foreground="White"
                                        Command="{Binding $parent[DataGrid].DataContext.ReturnRowCommand}" CommandParameter="{Binding}" />
                                <Button Content="✕ Ləğv et" IsVisible="{Binding CanCancel}" FontSize="10" Padding="6,2"
                                        Background="#E03131" Foreground="White"
                                        Command="{Binding $parent[DataGrid].DataContext.CancelRowCommand}" CommandParameter="{Binding}" />
                                <Button Content="💰 Fakturaya bax" IsVisible="{Binding HasInvoice}" FontSize="10" Padding="6,2"
                                        Background="#F08C00" Foreground="White"
                                        Command="{Binding $parent[DataGrid].DataContext.ViewInvoiceRowCommand}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- #41 — sıra: Status, Növ, Müştəri, Yaradan, Maliyyə, Tarixlər, № -->
                <DataGridTemplateColumn Header="Status" Width="Auto" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding Status, Converter={StaticResource StatusColor}}"
                                    CornerRadius="4" Padding="8,3" Margin="6,2" HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Növ" Binding="{Binding OrderType}" Width="Auto" />
                <DataGridTextColumn Header="Müştəri" Binding="{Binding CustomerName}" Width="2*" />
                <DataGridTemplateColumn Header="Yaradan" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CreatedByName}" />
                                <TextBlock Text="{Binding CreatedByRole}" Foreground="#8A90A6" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- #41 — Maliyyə: məbləğ + depozit + tutulma + qaytarma bir yerdə -->
                <DataGridTemplateColumn Header="Maliyyə" Width="Auto" MinWidth="150" SortMemberPath="Total">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,1" VerticalAlignment="Center">
                                <TextBlock FontWeight="Bold" FontSize="12">
                                    <Run Text="{Binding Total, StringFormat={}{0:0.00}}" />
                                    <Run Text="{Binding Currency}" />
                                </TextBlock>
                                <TextBlock FontSize="10" Foreground="#5A6072"
                                           ToolTip.Tip="{Binding DepositStatus, StringFormat='Depozit statusu: {0}'}">
                                    <Run Text="Dep:" /><Run Text="{Binding Deposit, StringFormat={}{0:0.} }" />
                                    <Run Text="· Qayt:" /><Run Text="{Binding DepositRefund, StringFormat={}{0:0.}}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Başlama" Binding="{Binding StartDate}" Width="Auto" />
                <DataGridTextColumn Header="Bitmə" Binding="{Binding EndDate}" Width="Auto" />
                <!-- #40 — № kompakt (tam nömrə tooltip-də) -->
                <DataGridTemplateColumn Header="№" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding OrderNumber}" Margin="6,0" VerticalAlignment="Center"
                                       MaxWidth="70" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding OrderNumber}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="5" Text="{Binding Status}" Foreground="#5A6072" Margin="0,10,0,0" />
    </Grid>

    <!-- #17 — ödəniş paneli (ekran ortası, göze girən) -->
    <Border IsVisible="{Binding ShowPaymentPrompt}"
            Background="#66000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border Background="White" BorderBrush="#1971C2" BorderThickness="2" CornerRadius="14"
                Padding="26,22" MinWidth="460" MaxWidth="560"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BoxShadow="0 8 28 0 #40000000">
            <StackPanel Spacing="12">
                <TextBlock Text="💰 Ödəniş" FontSize="18" FontWeight="Bold" Foreground="#1971C2" />
                <TextBlock Text="{Binding PaymentPromptTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsReturnPrompt}">
                    <TextBlock Text="Zədə:" VerticalAlignment="Center" />
                    <TextBox Width="90" PlaceholderText="0" Text="{Binding PromptDamage}" />
                    <TextBlock Text="Cərimə:" VerticalAlignment="Center" />
                    <TextBox Width="90" PlaceholderText="0" Text="{Binding PromptPenalty}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Nə qədər verildi:" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBox Width="120" Text="{Binding PaymentAmount}" />
                    <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" Width="110" />
                </StackPanel>
                <TextBox PlaceholderText="Qeyd (mütləq)" Text="{Binding PaymentNote}" />
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Content="Ödəniş yoxdur" Command="{Binding SkipPaymentCommand}" Padding="14,8" />
                    <Button Content="✓ Ödənişi qeyd et" Command="{Binding SubmitPaymentCommand}"
                            Background="#2F9E44" Foreground="White" Padding="16,8" FontWeight="SemiBold" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
    </Panel>
</UserControl>
