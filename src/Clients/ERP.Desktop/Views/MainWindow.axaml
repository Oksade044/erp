<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ERP.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
        x:Class="ERP.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1200" Height="720"
        RequestedThemeVariant="Light"
        Background="#F4F5F7"
        Title="{Binding Title}">

    <Grid ColumnDefinitions="240,*">

        <!-- SOL: tree-menyu -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <!-- Loqo -->
                <Border DockPanel.Dock="Top" Padding="18,16,18,12" BorderBrush="#EEF0F2" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="1">
                        <TextBlock Text="ERP" FontSize="20" FontWeight="Bold" Foreground="#111827" />
                        <TextBlock Text="İdarəetmə paneli" FontSize="11" Foreground="#9CA3AF" />
                    </StackPanel>
                </Border>

                <!-- İstifadəçi + çıxış -->
                <Border DockPanel.Dock="Bottom" Padding="14,10" BorderBrush="#EEF0F2" BorderThickness="0,1,0,0">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="Çıxış" Command="{Binding LogoutCommand}"
                                Padding="10,5" FontSize="12" Background="#F3F4F6" Foreground="#374151" />
                        <TextBlock Text="{Binding CurrentUser}" Foreground="#6B7280" FontSize="11"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <!-- Qruplar -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Menu}" Margin="8,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavGroup">
                                <Expander IsExpanded="{Binding IsExpanded}" IsVisible="{Binding HasVisible}"
                                          Classes="nav" Margin="0,1">
                                    <Expander.Header>
                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#9CA3AF" />
                                    </Expander.Header>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:NavItem">
                                                <Button Content="{Binding Label}" Command="{Binding Command}"
                                                        IsVisible="{Binding IsVisible}" Classes="navitem" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- SAĞ: tab iş sahəsi -->
        <TabControl Grid.Column="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                    Padding="0" Margin="0" Background="Transparent">
            <TabControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WorkspaceTab">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="13" />
                        <Button Content="✕" Command="{Binding CloseCommand}" CommandParameter="{Binding}"
                                Classes="tabclose" />
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate x:DataType="vm:WorkspaceTab">
                    <Border Background="White" Margin="10" CornerRadius="10" BorderBrush="#E5E7EB" BorderThickness="1">
                        <ContentControl Content="{Binding Content}" />
                    </Border>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>

    <Window.Styles>
        <!-- Qrup Expander: sadə, çərçivəsiz -->
        <Style Selector="Expander.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Expander.nav ToggleButton">
            <Setter Property="Padding" Value="10,6" />
        </Style>

        <!-- Menyu bölmə düymələri -->
        <Style Selector="Button.navitem">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Padding" Value="20,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.navitem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="TextElement.Foreground" Value="#111827" />
        </Style>

        <!-- Tab bağla düyməsi -->
        <Style Selector="Button.tabclose">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.tabclose:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FEE2E2" />
            <Setter Property="TextElement.Foreground" Value="#C92A2A" />
        </Style>
    </Window.Styles>

</Window>
