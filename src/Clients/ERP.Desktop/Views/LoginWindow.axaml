<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ERP.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="480"
        x:Class="ERP.Desktop.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Width="420" Height="480"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Title="ERP — Giriş">

    <Border Background="#1E2130">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300" Spacing="14">
            <TextBlock Text="ERP" FontSize="42" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
            <TextBlock Text="Toy Dekoru &amp; Tədbir Avadanlığı İcarəsi" FontSize="12"
                       Foreground="#8A90A6" HorizontalAlignment="Center" Margin="0,0,0,16" TextAlignment="Center" />

            <TextBlock Text="İstifadəçi adı" Foreground="#D5D8E4" FontSize="12" />
            <TextBox Text="{Binding Username}" PlaceholderText="admin" />

            <TextBlock Text="Parol" Foreground="#D5D8E4" FontSize="12" />
            <TextBox Text="{Binding Password}" PasswordChar="•" PlaceholderText="••••••" />

            <Button Content="Daxil ol" Command="{Binding LoginCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="#3B5BDB" Foreground="White" Padding="0,12" Margin="0,10,0,0" />

            <TextBlock Text="{Binding Error}" Foreground="#FF8787" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center" />
        </StackPanel>
    </Border>
</Window>
