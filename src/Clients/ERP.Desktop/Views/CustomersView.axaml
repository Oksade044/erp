<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Desktop.ViewModels"
             xmlns:ctrl="using:ERP.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="620"
             x:Class="ERP.Desktop.Views.CustomersView"
             x:DataType="vm:CustomersViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="Müştərilər" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ctrl:InfoHelp Title="Müştərilər (CRM)"
                           Text="Sizdən avadanlıq/dekor icarə GÖTÜRƏN şəxs və ya şirkətlər. Buradan müştəri qeyd olunur, sonra 'Sifarişlər'də onlara icarə verilir."
                           Note="Diqqət: müştəri sizdən icarə götürür; təchizatçı isə sizə mal satır — qarışdırmayın." />
        </StackPanel>

        <!-- Axtarış + yeni müştəri forması -->
        <Border Grid.Row="1" Background="#F5F6FA" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Width="240" PlaceholderText="Ad və ya telefon üzrə axtar"
                             Text="{Binding Search}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding LoadCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Content="Axtar" Command="{Binding LoadCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox ItemsSource="{Binding CustomerTypes}" SelectedItem="{Binding NewType}" Width="120" />
                    <TextBox Width="180" PlaceholderText="Ad *" Text="{Binding NewName}" />
                    <TextBox Width="140" PlaceholderText="Telefon *" Text="{Binding NewPhone}" />
                    <TextBox Width="160" PlaceholderText="E-poçt" Text="{Binding NewEmail}" />
                    <TextBox Width="120" PlaceholderText="Şəhər" Text="{Binding NewCity}" />
                    <Button Content="+ Əlavə et" Command="{Binding AddCommand}"
                            Background="#3B5BDB" Foreground="White" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Siyahı -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Customers}" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E0E2EA">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ad" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Növ" Binding="{Binding Type}" Width="Auto" />
                <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="*" />
                <DataGridTextColumn Header="E-poçt" Binding="{Binding Email}" Width="*" />
                <DataGridTextColumn Header="Şəhər" Binding="{Binding City}" Width="Auto" />
                <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsActive}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#5A6072" Margin="0,10,0,0" />
    </Grid>
</UserControl>
