<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="620"
             x:Class="ERP.Desktop.Views.PayrollView"
             x:DataType="vm:PayrollViewModel">

    <Panel>
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="24">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="Əməkhaqqı" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="ⓘ" FontSize="14" Width="28" Height="28" Padding="0" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" Foreground="#3B5BDB"
                    ToolTip.Tip="Əməkhaqqı necə hesablanır?">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel MaxWidth="440" Spacing="6">
                            <TextBlock Text="Əməkhaqqı hesablanması" FontWeight="SemiBold" />
                            <TextBlock TextWrapping="Wrap" Text="İşçi seçilir, il/ay göstərilir. Əsas maaş işçinin kartındakı maaşdan avtomatik götürülür." />
                            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                                       Text="Son (net) maaş = Əsas maaş + Bonus − Tutulma" />
                            <TextBlock TextWrapping="Wrap" Foreground="#5A6072"
                                       Text="• Hissə-hissə ödəniş: məs. 3000 maaşın 1500-ü indi ödənilir, qalıq borc kimi qalır.&#10;• Checkbox ilə bir neçə işçini seçib toplu ödəniş etmək olar.&#10;• Aylıq bonus əlavə edilə bilər. Hər ödəniş avtomatik Maliyyəyə məxaric yazır." />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBox Width="220" PlaceholderText="İşçi adı və ya № üzrə axtar (yazdıqca süzülür)" Text="{Binding Search}"
                     ToolTip.Tip="Yazdıqca süzülür, Enter də işləyir">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding LoadCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Content="🔍 Axtar" Command="{Binding LoadCommand}" />
            <Button Content="⟳ Yenilə" Command="{Binding LoadCommand}" />
            <Button Content="💵 Seçilənləri ödə" Command="{Binding OpenPayPanelCommand}"
                    Background="#1971C2" Foreground="White"
                    ToolTip.Tip="Checkbox ilə işçi(ləri) seçin — açılan paneldə hər birinə ayrıca məbləğ + bonus yazın (#20)." />
        </StackPanel>

        <!-- Yeni hesablama forması -->
        <Border Grid.Row="2" Background="#F5F6FA" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel Spacing="8">
                <TextBlock Text="Yeni əməkhaqqı hesabla" FontWeight="SemiBold" />
                <TextBlock Text="Əsas maaş işçinin kartından avtomatik götürülür. Son maaş = Əsas + Bonus − Tutulma."
                           Foreground="#8A90A6" FontSize="12" />
                <WrapPanel>
                    <StackPanel Width="210" Margin="0,0,12,8">
                        <TextBlock Text="İşçi *" FontSize="12" Foreground="#5A6072" />
                        <ComboBox ItemsSource="{Binding AllEmployees}" SelectedItem="{Binding NewEmployee}"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:CompileBindings="False"><TextBlock Text="{Binding FullName}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding NewEmployeeSalaryText}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#3B5BDB" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Width="90" Margin="0,0,12,8">
                        <TextBlock Text="İl" FontSize="12" Foreground="#5A6072" />
                        <TextBox PlaceholderText="2026" Text="{Binding NewYear}" />
                    </StackPanel>
                    <StackPanel Width="80" Margin="0,0,12,8">
                        <TextBlock Text="Ay (1-12)" FontSize="12" Foreground="#5A6072" />
                        <TextBox PlaceholderText="7" Text="{Binding NewMonth}" />
                    </StackPanel>
                    <StackPanel Width="130" Margin="0,0,12,8">
                        <TextBlock Text="Bonus / mükafat" FontSize="12" Foreground="#5A6072" />
                        <TextBox PlaceholderText="0" Text="{Binding NewBonus}" />
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,12,8">
                        <TextBlock Text="Tutulma (kəsinti/cərimə)" FontSize="12" Foreground="#5A6072" />
                        <TextBox PlaceholderText="0" Text="{Binding NewDeduction}" />
                    </StackPanel>
                </WrapPanel>
                <Button Content="+ Hesabla" Command="{Binding AddCommand}"
                        Background="#3B5BDB" Foreground="White" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <!-- Siyahı (checkbox ilə çoxlu seçim) -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Payrolls}" SelectedItem="{Binding Selected}"
                  IsReadOnly="True" GridLinesVisibility="Horizontal"
                  BorderThickness="1" BorderBrush="#E0E2EA">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="☑" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PayrollRow">
                            <CheckBox IsChecked="{Binding IsSelected}" Margin="8,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="№" Binding="{Binding PayrollNumber}" Width="Auto" />
                <DataGridTextColumn Header="İşçi" Binding="{Binding EmployeeName}" Width="2*" />
                <DataGridTextColumn Header="İl" Binding="{Binding Year}" Width="Auto" />
                <DataGridTextColumn Header="Ay" Binding="{Binding Month}" Width="Auto" />
                <DataGridTextColumn Header="Əsas" Binding="{Binding BaseSalary, StringFormat={}{0:0.00}}" Width="*" />
                <DataGridTextColumn Header="Bonus" Binding="{Binding Bonus, StringFormat={}{0:0.00}}" Width="*" />
                <DataGridTextColumn Header="Tutulma" Binding="{Binding Deduction, StringFormat={}{0:0.00}}" Width="*" />
                <DataGridTextColumn Header="Net" Binding="{Binding NetSalary, StringFormat={}{0:0.00}}" Width="*" />
                <DataGridTextColumn Header="Ödənilmiş" Binding="{Binding PaidAmount, StringFormat={}{0:0.00}}" Width="*" />
                <DataGridTextColumn Header="Qalıq" Binding="{Binding Remaining, StringFormat={}{0:0.00}}" Width="*" />
                <DataGridTextColumn Header="Val." Binding="{Binding Currency}" Width="Auto" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Seçilmiş işçinin ödəniş tarixçəsi (sətrə klik → hansı tarixdə nə qədər verildi) -->
        <Border Grid.Row="4" Background="#F0F4FF" CornerRadius="8" Padding="14" Margin="0,12,0,0">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding SelectedSummary}" FontWeight="SemiBold" Foreground="#1F2A5A" TextWrapping="Wrap" />
                <TextBlock Text="Ödəniş tarixçəsi (sətrə klik edin):" FontSize="12" Foreground="#5A6072" />
                <DataGrid ItemsSource="{Binding SelectedHistory}" IsReadOnly="True" MaxHeight="150"
                          GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#D0D7E2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarix" Binding="{Binding Date}" Width="Auto" />
                        <DataGridTextColumn Header="Məbləğ" Binding="{Binding Amount, StringFormat={}{0:0.00}}" Width="*" />
                        <DataGridTextColumn Header="Val." Binding="{Binding Currency}" Width="Auto" />
                        <DataGridTextColumn Header="Üsul" Binding="{Binding Method}" Width="Auto" />
                        <DataGridCheckBoxColumn Header="Bonus?" Binding="{Binding IsBonus}" Width="Auto" />
                        <DataGridTextColumn Header="Qeyd" Binding="{Binding Note}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="5" Text="{Binding Status}" Foreground="#5A6072" Margin="0,10,0,0" />
    </Grid>

    <!-- #20 — ödəniş paneli (ekran ortası): hər seçilmiş işçiyə ayrıca məbləğ + bonus -->
    <Border IsVisible="{Binding ShowPayPanel}" Background="#66000000">
        <Border Background="White" BorderBrush="#1971C2" BorderThickness="2" CornerRadius="14"
                Padding="24,20" MinWidth="560" MaxWidth="720" MaxHeight="560"
                HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 8 28 0 #40000000">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="💵 Seçilən işçilərə ödəniş" FontSize="18" FontWeight="Bold"
                           Foreground="#1971C2" Margin="0,0,0,6" />
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                    <TextBlock Text="Ödəniş üsulu:" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PayPanelMethod}" Width="120" />
                    <TextBlock Text="Hər işçi üçün məbləğ və (istəyə görə) bonus yazın:" VerticalAlignment="Center"
                               Foreground="#5A6072" FontSize="12" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="Ləğv et" Command="{Binding CancelPayPanelCommand}" Padding="14,8" />
                    <Button Content="✓ Ödənişləri qeyd et" Command="{Binding SubmitPayAllCommand}"
                            Background="#2F9E44" Foreground="White" Padding="16,8" FontWeight="SemiBold" />
                </StackPanel>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding PayEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PayEntry">
                                <Border Background="#F5F6FA" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <StackPanel Width="160" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding EmployeeName}" FontWeight="SemiBold" />
                                            <TextBlock FontSize="11" Foreground="#5A6072">
                                                <Run Text="Ay:" /><Run Text="{Binding Period}" />
                                                <Run Text=" · qalıq:" /><Run Text="{Binding Remaining, StringFormat={}{0:0.00}}" />
                                                <Run Text="{Binding Currency}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Width="130">
                                            <TextBlock Text="Ödəniləcək məbləğ" FontSize="11" Foreground="#5A6072" />
                                            <TextBox Text="{Binding Amount}" />
                                        </StackPanel>
                                        <StackPanel Width="130">
                                            <TextBlock Text="Bonus (istəyə görə)" FontSize="11" Foreground="#5A6072" />
                                            <TextBox Text="{Binding Bonus}" PlaceholderText="0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Border>
    </Panel>
</UserControl>
