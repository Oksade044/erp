<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Desktop.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="640"
             x:Class="ERP.Desktop.Views.FinanceView"
             x:DataType="vm:FinanceViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="24">

        <TextBlock Grid.Row="0" Text="Maliyyə — Kassa" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

        <!-- Xülasə kartları -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <Border Background="#EBFBEE" CornerRadius="8" Padding="18,12" Width="200">
                <StackPanel>
                    <TextBlock Text="Ümumi Mədaxil" Foreground="#2B8A3E" FontSize="12" />
                    <TextBlock Text="{Binding TotalIncome, StringFormat={}{0:0.00} AZN}"
                               FontSize="20" FontWeight="Bold" Foreground="#2B8A3E" />
                </StackPanel>
            </Border>
            <Border Background="#FFF0F0" CornerRadius="8" Padding="18,12" Width="200">
                <StackPanel>
                    <TextBlock Text="Ümumi Məxaric" Foreground="#C92A2A" FontSize="12" />
                    <TextBlock Text="{Binding TotalExpense, StringFormat={}{0:0.00} AZN}"
                               FontSize="20" FontWeight="Bold" Foreground="#C92A2A" />
                </StackPanel>
            </Border>
            <Border Background="#E7F5FF" CornerRadius="8" Padding="18,12" Width="200">
                <StackPanel>
                    <TextBlock Text="Kassa Balansı" Foreground="#1971C2" FontSize="12" />
                    <TextBlock Text="{Binding Balance, StringFormat={}{0:0.00} AZN}"
                               FontSize="20" FontWeight="Bold" Foreground="#1971C2" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Axtarış + filtr -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBox Width="200" PlaceholderText="№, kateqoriya və ya açıqlama" Text="{Binding Search}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding LoadCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
            <ComboBox ItemsSource="{Binding FilterTypes}" SelectedItem="{Binding FilterType}" Width="120" />
            <Button Content="Axtar / Yenilə" Command="{Binding LoadCommand}" />
        </StackPanel>

        <!-- Yeni əməliyyat forması -->
        <Border Grid.Row="3" Background="#F5F6FA" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox ItemsSource="{Binding TransactionTypes}" SelectedItem="{Binding NewTransactionType}" Width="110" />
                <TextBox Width="160" PlaceholderText="Kateqoriya *" Text="{Binding NewCategory}" />
                <TextBox Width="110" PlaceholderText="Məbləğ *" Text="{Binding NewAmount}" />
                <DatePicker SelectedDate="{Binding NewDate}" />
                <ComboBox ItemsSource="{Binding Methods}" SelectedItem="{Binding NewMethod}" Width="110" />
                <TextBox Width="150" PlaceholderText="Açıqlama" Text="{Binding NewDescription}" />
                <Button Content="+ Əlavə et" Command="{Binding AddCommand}"
                        Background="#3B5BDB" Foreground="White" />
            </StackPanel>
        </Border>

        <!-- Siyahı -->
        <DataGrid Grid.Row="4" ItemsSource="{Binding Transactions}" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E0E2EA">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding TransactionNumber}" Width="Auto" />
                <DataGridTextColumn Header="Növ" Binding="{Binding Type}" Width="Auto" />
                <DataGridTextColumn Header="Kateqoriya" Binding="{Binding Category}" Width="2*" />
                <DataGridTextColumn Header="Məbləğ" Binding="{Binding Amount}" Width="*" />
                <DataGridTextColumn Header="Tarix" Binding="{Binding Date}" Width="Auto" />
                <DataGridTextColumn Header="Üsul" Binding="{Binding Method}" Width="Auto" />
                <DataGridTextColumn Header="Açıqlama" Binding="{Binding Description}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="5" Text="{Binding Status}" Foreground="#5A6072" Margin="0,10,0,0" />
    </Grid>
</UserControl>
