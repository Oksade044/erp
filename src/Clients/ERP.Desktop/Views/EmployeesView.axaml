<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Desktop.ViewModels"
             xmlns:ctrl="using:ERP.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="620"
             x:Class="ERP.Desktop.Views.EmployeesView"
             x:DataType="vm:EmployeesViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="İşçilər (HR)" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ctrl:InfoHelp Title="İşçilər (Kadr uçotu)"
                           Text="Şirkət əməkdaşlarının kartotekası: ad, vəzifə, şöbə, əlaqə, işə qəbul tarixi, maaş və status (İşləyir/Məzuniyyətdə/İşdən çıxmış)."
                           Note="İşçi burada qeyd olunur; 'Davamiyyət' və 'Əməkhaqqı' bölmələri bu işçilərə əsaslanır." />
        </StackPanel>

        <!-- Axtarış + yeni işçi forması -->
        <Border Grid.Row="1" Background="#F5F6FA" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ListMode}">
                    <TextBox Width="240" PlaceholderText="Ad, vəzifə, şöbə və ya telefon üzrə axtar"
                             Text="{Binding Search}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding LoadCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Content="Axtar" Command="{Binding LoadCommand}" />
                    <Button Content="⟳ Yenilə" Command="{Binding LoadCommand}" />
                    <Button Content="✎ Redaktə et" Command="{Binding EditSelectedCommand}" IsVisible="{Binding CanEdit}"
                            ToolTip.Tip="Seçilmiş təmsilçini redaktə et (ad, vəzifə, maaş və s.)" />
                    <Button Content="🗑 Sil" Command="{Binding DeleteSelectedCommand}" Background="#E03131" Foreground="White"
                            IsVisible="{Binding CanEdit}" ToolTip.Tip="Seçilmiş təmsilçini sil (bərpa oluna bilər)" />
                </StackPanel>
                <TextBlock Text="✎ Təmsilçi redaktə olunur" FontWeight="SemiBold" Foreground="#3B5BDB"
                           IsVisible="{Binding IsEditing}" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding FormVisible}">
                    <TextBox Width="200" PlaceholderText="Ad Soyad *" Text="{Binding NewFullName}" />
                    <TextBox Width="150" PlaceholderText="Telefon *" Text="{Binding NewPhone}" />
                </StackPanel>
                <!-- Mobil/sistem girişi — şifrə verilsə təmsilçi Android/iOS-a daxil ola bilər (rol defolt Kassir). -->
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CreateMode}">
                    <TextBlock Text="🔑 Mobil giriş:" VerticalAlignment="Center" Foreground="#5A6072" />
                    <TextBox Width="200" PlaceholderText="İstifadəçi adı (boş=telefon)" Text="{Binding NewLoginUsername}"
                             ToolTip.Tip="Boş buraxsanız telefon nömrəsi istifadəçi adı olur" />
                    <TextBox Width="160" PlaceholderText="Şifrə" Text="{Binding NewLoginPassword}" PasswordChar="•"
                             ToolTip.Tip="Şifrə versəniz təmsilçi üçün mobil giriş yaradılır (rol: Kassir)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding FormVisible}">
                    <TextBox Width="160" PlaceholderText="E-poçt" Text="{Binding NewEmail}" />
                    <TextBlock Text="İşə qəbul:" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding NewHireDate}" />
                    <TextBox Width="120" PlaceholderText="Əməkhaqqı" Text="{Binding NewSalary}"
                             IsVisible="{Binding CanViewSalary}" />
                    <Button Content="{Binding SaveButtonText}" Command="{Binding AddCommand}"
                            Background="#3B5BDB" Foreground="White" />
                    <Button Content="✕ Ləğv" Command="{Binding CancelEditCommand}"
                            IsVisible="{Binding IsEditing}" Background="#E03131" Foreground="White" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Siyahı -->
        <DataGrid Grid.Row="2" x:Name="EmployeesGrid" ItemsSource="{Binding Employees}" SelectedItem="{Binding Selected}" IsReadOnly="True" IsVisible="{Binding ListMode}"
                  GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E0E2EA">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding EmployeeNumber}" Width="Auto" />
                <DataGridTextColumn Header="Ad Soyad" Binding="{Binding FullName}" Width="2*" />
                <DataGridTextColumn Header="Vəzifə" Binding="{Binding Position}" Width="*" />
                <DataGridTextColumn Header="Şöbə" Binding="{Binding Department}" Width="*" />
                <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="*" />
                <DataGridTextColumn Header="İşə qəbul" Binding="{Binding HireDate}" Width="Auto" />
                <DataGridTextColumn Header="Əməkhaqqı" Binding="{Binding Salary}" Width="Auto" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#5A6072" Margin="0,10,0,0" />
    </Grid>
</UserControl>
