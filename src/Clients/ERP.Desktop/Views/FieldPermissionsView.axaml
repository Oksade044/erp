<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Desktop.ViewModels"
             xmlns:ctrl="using:ERP.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="560"
             x:Class="ERP.Desktop.Views.FieldPermissionsView"
             x:DataType="vm:FieldPermissionsViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="Sahə Görünürlüyü" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ctrl:InfoHelp Title="Sahə görünürlüyü (kim nəyi görsün)"
                           Text="Həssas sahələri hansı rolların görəcəyini seçin. Məs. satış işçisi (Kassir) 'alış qiyməti'ni görməsin deyə qutunu boş buraxın."
                           Note="Admin həmişə hər şeyi görür (kilidli). Dəyişiklik istifadəçinin növbəti girişində tam qüvvəyə minir." />
        </StackPanel>

        <Border Grid.Row="1" Background="#FFF9DB" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <TextBlock TextWrapping="Wrap" Foreground="#5A6072"
                       Text="Qutu seçilidirsə — həmin rol sahəni görür. Boşdursa — görmür. Admin sütunu göstərilmir, çünki Admin həmişə görür." />
        </Border>

        <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <!-- Başlıq sətri -->
            <Grid Grid.Row="0" ColumnDefinitions="*,120,120,120" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Text="Sahə" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="Menecer" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Anbardar" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="Kassir" FontWeight="SemiBold" HorizontalAlignment="Center" />
            </Grid>

            <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FieldPermissionRow">
                        <Border BorderBrush="#E0E2EA" BorderThickness="0,0,0,1" Padding="0,8">
                            <Grid ColumnDefinitions="*,120,120,120">
                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding Menecer}" HorizontalAlignment="Center" />
                                <CheckBox Grid.Column="2" IsChecked="{Binding Anbardar}" HorizontalAlignment="Center" />
                                <CheckBox Grid.Column="3" IsChecked="{Binding Kassir}" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
            <Button Content="💾 Yadda saxla" Command="{Binding SaveCommand}"
                    Background="#2F9E44" Foreground="White" />
            <Button Content="⟳ Yenilə" Command="{Binding LoadCommand}" />
            <TextBlock Text="{Binding Status}" Foreground="#5A6072" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
