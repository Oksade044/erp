<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ERP.Desktop.ViewModels"
             xmlns:ctrl="using:ERP.Desktop.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="620"
             x:Class="ERP.Desktop.Views.WarehousesView"
             x:DataType="vm:WarehousesViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <TextBlock Text="Anbarlar" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ctrl:InfoHelp Title="Anbarlar"
                           Text="Avadanlığın saxlandığı fiziki yerlər (məs. Mərkəzi anbar, Filial anbarı). Hər anbarın unikal kodu var."
                           Note="Məhsulların hansı anbarda neçə ədəd olduğu 'Stok' bölməsində idarə olunur." />
        </StackPanel>

        <Border Grid.Row="1" Background="#F5F6FA" CornerRadius="8" Padding="16" Margin="0,0,0,16">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Width="240" PlaceholderText="Ad və ya kod üzrə axtar" Text="{Binding Search}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding LoadCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Content="Axtar" Command="{Binding LoadCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Width="200" PlaceholderText="Ad *" Text="{Binding NewName}" />
                    <TextBox Width="130" PlaceholderText="Kod *" Text="{Binding NewCode}" />
                    <TextBox Width="130" PlaceholderText="Şəhər" Text="{Binding NewCity}" />
                    <TextBox Width="140" PlaceholderText="Telefon" Text="{Binding NewPhone}" />
                    <Button Content="+ Əlavə et" Command="{Binding AddCommand}"
                            Background="#3B5BDB" Foreground="White" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Warehouses}" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="#E0E2EA">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ad" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Kod" Binding="{Binding Code}" Width="*" />
                <DataGridTextColumn Header="Şəhər" Binding="{Binding City}" Width="*" />
                <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="*" />
                <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsActive}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="#5A6072" Margin="0,10,0,0" />
    </Grid>
</UserControl>
