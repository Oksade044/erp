<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ERP.Mobile.ViewModels"
             xmlns:dto="clr-namespace:ERP.Shared.Contracts.Representatives;assembly=ERP.Shared.Contracts"
             x:Class="ERP.Mobile.Views.DebtPage"
             x:DataType="vm:DebtViewModel"
             Title="Borcum"
             BackgroundColor="#F1F3F5">
    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">
                <Border Style="{StaticResource Card}" BackgroundColor="#111827">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="Cari balans" FontSize="13" TextColor="#9CA3AF" HorizontalOptions="Center" />
                        <Label Text="{Binding BalanceText}" FontSize="34" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                        <Label Text="{Binding BalanceHint}" FontSize="12" TextColor="#D1D5DB" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Hərəkət tarixçəsi" FontAttributes="Bold" />
                <CollectionView ItemsSource="{Binding Entries}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="{Binding Status}" TextColor="Gray" Margin="0,20" HorizontalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:RepresentativeEntryDto">
                            <Border Style="{StaticResource Card}" Margin="0,4" Padding="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Type}" FontAttributes="Bold" FontSize="14" />
                                        <Label Text="{Binding Description}" FontSize="12" TextColor="Gray" />
                                        <Label Text="{Binding Date, StringFormat='{0:dd.MM.yyyy}'}" FontSize="11" TextColor="#9CA3AF" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding SignedAmount, StringFormat='{0:+0.00;-0.00} AZN'}"
                                           FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
