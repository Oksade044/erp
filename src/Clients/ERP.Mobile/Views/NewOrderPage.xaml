<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ERP.Mobile.ViewModels"
             xmlns:cdto="clr-namespace:ERP.Shared.Contracts.Customers;assembly=ERP.Shared.Contracts"
             xmlns:pdto="clr-namespace:ERP.Shared.Contracts.Products;assembly=ERP.Shared.Contracts"
             x:Class="ERP.Mobile.Views.NewOrderPage"
             x:DataType="vm:NewOrderViewModel"
             Title="Yeni sifariş"
             BackgroundColor="#F1F3F5">
    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="12">

            <!-- 1. Müştəri -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="1. Müştəri" Style="{StaticResource SectionTitle}" />
                    <Entry Placeholder="Ad və ya telefonla axtar" Text="{Binding CustomerSearch}" />
                    <CollectionView x:Name="CustomerList" ItemsSource="{Binding CustomerResults}"
                                    SelectionMode="Single" SelectionChanged="OnCustomerSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="cdto:CustomerDto">
                                <Grid Padding="8" ColumnDefinitions="*,Auto" BackgroundColor="#F8F9FA" Margin="0,2">
                                    <Label Text="{Binding Name}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Phone}" FontSize="12" TextColor="Gray" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label Text="{Binding SelectedCustomer.Name, StringFormat='✓ Seçilmiş müştəri: {0}'}" TextColor="#2F9E44" FontAttributes="Bold" IsVisible="{Binding SelectedCustomer, Converter={StaticResource NotNull}}" />
                    <Button Text="+ Yeni müştəri yarat" FontSize="13" BackgroundColor="#868E96" Command="{Binding ToggleCreatingCustomerCommand}" />
                    <VerticalStackLayout IsVisible="{Binding CreatingCustomer}" Spacing="6" BackgroundColor="#F1F3F5" Padding="10">
                        <Label Text="Ad Soyad" FontSize="12" TextColor="Gray" />
                        <Entry Placeholder="Məs. Aysel Məmmədova" Text="{Binding NewCustomerName}" />
                        <Label Text="Telefon" FontSize="12" TextColor="Gray" />
                        <Entry Placeholder="Məs. 0501234567" Keyboard="Telephone" Text="{Binding NewCustomerPhone}" />
                        <Label Text="Ünvan (istəyə görə)" FontSize="12" TextColor="Gray" />
                        <Entry Placeholder="Ünvan" Text="{Binding NewCustomerAddress}" />
                        <Button Text="Müştərini yadda saxla" Command="{Binding CreateCustomerCommand}" FontSize="13" BackgroundColor="#0CA678" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 2. Tarixlər -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="2. Tarix və növ" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" Text="Başlama:" VerticalOptions="Center" WidthRequest="70" />
                        <DatePicker Grid.Row="0" Grid.Column="1" Date="{Binding StartDate}" />
                        <Label Grid.Row="1" Grid.Column="0" Text="Bitmə:" VerticalOptions="Center" WidthRequest="70" />
                        <DatePicker Grid.Row="1" Grid.Column="1" Date="{Binding EndDate}" />
                        <Label Grid.Row="2" Grid.Column="0" Text="Növ:" VerticalOptions="Center" WidthRequest="70" />
                        <Picker Grid.Row="2" Grid.Column="1" ItemsSource="{Binding OrderTypes}" SelectedItem="{Binding OrderType}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 3. Məhsul əlavə et -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="3. Məhsul əlavə et" Style="{StaticResource SectionTitle}" />
                    <Entry Placeholder="Məhsul adı ilə axtar" Text="{Binding ProductSearch}" />
                    <CollectionView x:Name="ProductList" ItemsSource="{Binding ProductResults}"
                                    SelectionMode="Single" SelectionChanged="OnProductSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="pdto:ProductDto">
                                <Grid Padding="8" ColumnDefinitions="*,Auto" BackgroundColor="#F8F9FA" Margin="0,2">
                                    <Label Text="{Binding Name}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding RentalPrice, StringFormat='{0:0.00} AZN'}" FontSize="12" TextColor="Gray" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <VerticalStackLayout IsVisible="{Binding SelectedProduct, Converter={StaticResource NotNull}}" Spacing="8" BackgroundColor="#F1F3F5" Padding="10">
                        <Label Text="{Binding SelectedProduct.Name, StringFormat='✓ {0}'}" FontAttributes="Bold" />
                        <Label Text="Anbar (haradan götürülür):" FontSize="12" TextColor="Gray" />
                        <Picker ItemsSource="{Binding ProductStock}" SelectedItem="{Binding SelectedWarehouse}" ItemDisplayBinding="{Binding WarehouseName}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="Say" FontSize="12" TextColor="Gray" />
                            <Label Grid.Row="0" Grid.Column="1" Text="Qiymət (AZN)" FontSize="12" TextColor="Gray" />
                            <Entry Grid.Row="1" Grid.Column="0" Keyboard="Numeric" Text="{Binding LineQuantity}" />
                            <Entry Grid.Row="1" Grid.Column="1" Keyboard="Numeric" Text="{Binding LineUnitPrice}" />
                        </Grid>
                        <Button Text="Sifarişə əlavə et" Command="{Binding AddLineCommand}" FontSize="13" BackgroundColor="#1971C2" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- 4. Sətirlər -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="4. Sifariş sətirləri" Style="{StaticResource SectionTitle}" />
                    <Label Text="Silmək üçün sətrə toxunun." FontSize="12" TextColor="Gray" IsVisible="{Binding DraftLines.Count, Converter={StaticResource NotNull}}" />
                    <CollectionView x:Name="DraftList" ItemsSource="{Binding DraftLines}"
                                    SelectionMode="Single" SelectionChanged="OnDraftLineSelected">
                        <CollectionView.EmptyView>
                            <Label Text="Hələ məhsul əlavə edilməyib." TextColor="Gray" Margin="0,8" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:DraftLine">
                                <Grid Padding="6" ColumnDefinitions="*,Auto" Margin="0,2">
                                    <Label Text="{Binding Display}" VerticalOptions="Center" FontSize="13" />
                                    <Label Grid.Column="1" Text="✕" TextColor="#C92A2A" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <BoxView HeightRequest="1" Color="#E9ECEF" />
                    <Label Text="{Binding DraftTotal, StringFormat='Ümumi: {0:0.00} AZN'}" FontAttributes="Bold" FontSize="15" HorizontalOptions="End" />
                </VerticalStackLayout>
            </Border>

            <Button Text="✓ Sifarişi yarat" Command="{Binding CreateOrderCommand}" BackgroundColor="#2F9E44" FontSize="16" HeightRequest="50" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding Status}" TextColor="#1971C2" FontAttributes="Bold" HorizontalOptions="Center" IsVisible="{Binding Status, Converter={StaticResource NotNull}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
