<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ERP.Mobile.ViewModels"
             x:Class="ERP.Mobile.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Profil">
    <VerticalStackLayout Padding="20" Spacing="14">
        <Label Text="Profil" FontSize="22" FontAttributes="Bold" />
        <Border StrokeShape="RoundRectangle 10" Padding="16" BackgroundColor="#F8F9FA">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding FullName, StringFormat='Ad Soyad: {0}'}" />
                <Label Text="{Binding Username, StringFormat='İstifadəçi adı: {0}'}" />
                <Label Text="{Binding Role, StringFormat='Rol: {0}'}" />
                <Label Text="{Binding Server, StringFormat='Server: {0}'}" FontSize="12" TextColor="Gray" />
            </VerticalStackLayout>
        </Border>
        <Button Text="Çıxış" Command="{Binding LogoutCommand}" BackgroundColor="#C92A2A" />
    </VerticalStackLayout>
</ContentPage>
