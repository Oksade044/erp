<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ERP.Mobile.ViewModels"
             xmlns:dto="clr-namespace:ERP.Shared.Contracts.Orders;assembly=ERP.Shared.Contracts"
             x:Class="ERP.Mobile.Views.MyOrdersPage"
             x:DataType="vm:MyOrdersViewModel"
             Title="Sifarişlərim">
    <Grid RowDefinitions="Auto,Auto,*">
        <Label Grid.Row="0" Text="{Binding Title}" FontSize="18" FontAttributes="Bold" Padding="16,12,16,4" />

        <ScrollView Grid.Row="1" Orientation="Horizontal" Padding="12,0,12,8">
            <HorizontalStackLayout Spacing="8">
                <Button Text="Hamısı" Command="{Binding SetFilterCommand}" CommandParameter="all" FontSize="12" Padding="10,4" />
                <Button Text="Bugün təhvil" Command="{Binding SetFilterCommand}" CommandParameter="today-delivery" FontSize="12" Padding="10,4" />
                <Button Text="Bugün qaytarma" Command="{Binding SetFilterCommand}" CommandParameter="today-return" FontSize="12" Padding="10,4" />
                <Button Text="Aktiv" Command="{Binding SetFilterCommand}" CommandParameter="active" FontSize="12" Padding="10,4" />
                <Button Text="Gözləyən" Command="{Binding SetFilterCommand}" CommandParameter="pending" FontSize="12" Padding="10,4" />
            </HorizontalStackLayout>
        </ScrollView>

        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Orders}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="{Binding Status}" HorizontalOptions="Center" Margin="0,40" TextColor="Gray" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:OrderDto">
                        <Border StrokeShape="RoundRectangle 10" Margin="12,6" Padding="14" BackgroundColor="#FFFFFF" Stroke="#E0E2EA">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MyOrdersViewModel}}, Path=OpenCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding CustomerName}" FontAttributes="Bold" FontSize="15" />
                                    <Label Grid.Column="1" Text="{Binding Status}" FontSize="12" TextColor="#1971C2" />
                                </Grid>
                                <Label Text="{Binding OrderNumber}" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding StartDate, StringFormat='Tarix: {0:dd.MM.yyyy}'}" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding Total, StringFormat='Məbləğ: {0:0.00} AZN'}" FontSize="13" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
