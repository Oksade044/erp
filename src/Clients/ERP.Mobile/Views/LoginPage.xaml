<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ERP.Mobile.ViewModels"
             x:Class="ERP.Mobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Giriş"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="16" VerticalOptions="Center">
            <Label Text="ERP İşçi" FontSize="30" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="Şirkət hesabınızla daxil olun" FontSize="14" TextColor="Gray" HorizontalOptions="Center" Margin="0,0,0,10" />

            <Entry Placeholder="İstifadəçi adı" Text="{Binding Username}" ReturnType="Next" />
            <Entry Placeholder="Şifrə" Text="{Binding Password}" IsPassword="True" ReturnType="Done" />

            <Button Text="Daxil ol" Command="{Binding LoginCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding Error}" TextColor="#C92A2A" IsVisible="{Binding Error, Converter={StaticResource NotNull}}" />

            <Button Text="Server ayarları" BackgroundColor="Transparent" TextColor="#1971C2" Command="{Binding ToggleServerSettingsCommand}" />
            <Entry Placeholder="Server ünvanı (məs. http://10.0.2.2:5080)" Text="{Binding ServerUrl}" IsVisible="{Binding ShowServerSettings}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
