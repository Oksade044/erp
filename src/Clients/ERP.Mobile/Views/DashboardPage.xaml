<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ERP.Mobile.ViewModels"
             x:Class="ERP.Mobile.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="Əsas">
    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">
                <Label Text="{Binding Welcome}" FontSize="20" FontAttributes="Bold" />

                <!-- Təmsilçi borcu (əsas ekranda) -->
                <Border StrokeShape="RoundRectangle 14" BackgroundColor="#FFF0F0" Padding="18">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="💳 Borc vəziyyəti" FontSize="13" TextColor="#C92A2A" />
                        <Label Text="{Binding DebtText}" FontSize="26" FontAttributes="Bold" TextColor="#C92A2A" />
                        <Label Text="{Binding DebtSubText}" FontSize="12" TextColor="#868E96" />
                    </VerticalStackLayout>
                </Border>

                <!-- Borcu bağla → sifariş yarat -->
                <Button Text="➕ Sifariş yarat (borcu bağla)" Command="{Binding GoNewOrderCommand}"
                        BackgroundColor="#2F9E44" TextColor="White" FontSize="16" HeightRequest="54" />

                <!-- Bu ay bağladığınız (info) -->
                <Border StrokeShape="RoundRectangle 12" BackgroundColor="#E6FCF5" Padding="14">
                    <VerticalStackLayout>
                        <Label Text="Bu ay bağladığınız (dövriyyə)" FontSize="12" TextColor="#0CA678" />
                        <Label Text="{Binding Data.RevenueThisMonth, StringFormat='{0:0.00} AZN'}" FontSize="22" FontAttributes="Bold" TextColor="#0CA678" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding Status}" TextColor="Gray" IsVisible="{Binding Status, Converter={StaticResource NotNull}}" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
