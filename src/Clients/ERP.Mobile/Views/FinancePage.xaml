<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ERP.Mobile.ViewModels"
             x:Class="ERP.Mobile.Views.FinancePage"
             x:DataType="vm:FinanceViewModel"
             Title="Maliyyəm">
    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">
                <Label Text="Mənim dövriyyəm" FontSize="20" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <Border Grid.Row="0" Grid.Column="0" StrokeShape="RoundRectangle 12" BackgroundColor="#E6FCF5" Padding="14">
                        <VerticalStackLayout><Label Text="Bu gün" FontSize="12" TextColor="#0CA678"/><Label Text="{Binding Data.RevenueToday, StringFormat='{0:0.00} AZN'}" FontSize="20" FontAttributes="Bold" TextColor="#0CA678"/></VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 12" BackgroundColor="#E6FCF5" Padding="14">
                        <VerticalStackLayout><Label Text="Bu həftə" FontSize="12" TextColor="#0CA678"/><Label Text="{Binding Data.RevenueThisWeek, StringFormat='{0:0.00} AZN'}" FontSize="20" FontAttributes="Bold" TextColor="#0CA678"/></VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" StrokeShape="RoundRectangle 12" BackgroundColor="#E7F5FF" Padding="14">
                        <VerticalStackLayout><Label Text="Bu ay" FontSize="12" TextColor="#1971C2"/><Label Text="{Binding Data.RevenueThisMonth, StringFormat='{0:0.00} AZN'}" FontSize="20" FontAttributes="Bold" TextColor="#1971C2"/></VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" StrokeShape="RoundRectangle 12" BackgroundColor="#F3F0FF" Padding="14">
                        <VerticalStackLayout><Label Text="Bu il" FontSize="12" TextColor="#7048E8"/><Label Text="{Binding Data.RevenueThisYear, StringFormat='{0:0.00} AZN'}" FontSize="20" FontAttributes="Bold" TextColor="#7048E8"/></VerticalStackLayout>
                    </Border>
                </Grid>

                <Border StrokeShape="RoundRectangle 10" Padding="14" BackgroundColor="#F8F9FA">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding Data.OrdersThisMonth, StringFormat='Bu ay sifariş sayı: {0}'}" />
                        <Label Text="{Binding Data.RentalRevenueThisMonth, StringFormat='İcarə gəliri (ay): {0:0.00} AZN'}" />
                        <Label Text="{Binding Data.SaleRevenueThisMonth, StringFormat='Satış gəliri (ay): {0:0.00} AZN'}" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="{Binding Status}" TextColor="Gray" IsVisible="{Binding Status, Converter={StaticResource NotNull}}" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
